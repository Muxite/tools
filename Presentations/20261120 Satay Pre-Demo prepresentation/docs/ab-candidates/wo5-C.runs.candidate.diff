diff --git a/src/llama-batch-layout.h b/src/llama-batch-layout.h
new file mode 100644
index 0000000..100af21
--- /dev/null
+++ b/src/llama-batch-layout.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+struct llama_batch_layout {
+    const char * const gate_reason = read_gate();
+    uint64_t decisions = 0;
+    uint64_t rows = 0;
+    uint64_t bypasses = 0;
+
+    static int32_t aligned_limit(int32_t n_batch, int32_t n_ubatch) {
+        if (n_ubatch <= 0 || n_ubatch > n_batch) {
+            return 0;
+        }
+        return n_batch - n_batch % n_ubatch;
+    }
+
+private:
+    static const char * read_gate() {
+        const char * value = std::getenv("LLAMA_BATCH_LAYOUT");
+        const bool enabled = value != nullptr && std::strcmp(value, "1") == 0;
+        return enabled ? nullptr : value ? "invalid LLAMA_BATCH_LAYOUT value" : "LLAMA_BATCH_LAYOUT unset";
+    }
+};
+
+static_assert(sizeof(llama_batch_layout) <= 128, "batch layout mapper state exceeds its budget");
