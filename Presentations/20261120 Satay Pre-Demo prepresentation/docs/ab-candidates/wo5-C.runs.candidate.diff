+    int32_t batch_layout_prompt_limit(const server_slot & slot, bool do_checkpoint, int32_t n_batch, int32_t n_ubatch) {
+        const char * reason = batch_layout_context_reason();
+        const int32_t limit = reason ? 0 : llama_batch_layout::aligned_limit(n_batch, n_ubatch);
+        if (!reason) {
+            if (limit == 0) {
+                reason = "invalid effective batch limits";
+            } else if (batch.size() != 0) {
+                reason = "pending batch is not empty";
+            } else if (slot.task->type != SERVER_TASK_TYPE_COMPLETION || slot.need_embd() || !slot.can_split() ||
+                       slot.task->tokens.has_mtmd) {
+                reason = "request is not splittable text completion";
+            } else if (slot.task->is_parent() || slot.task->is_child() || slot.task->n_tokens_shared > 0) {
+                reason = "shared prompt";
+            } else if (do_checkpoint || !slot.prompt.checkpoints.empty()) {
+                reason = "prompt checkpoints";
+            } else if (slot.alora_invocation_start >= 0) {
+                reason = "aLoRA invocation";
+            } else if (slot.task->params.n_cache_reuse > 0) {
+                reason = "shifted prompt cache reuse";
+            }
+        }
+
+        if (reason) {
+            // Count attempts to enter the prompt row loop with the stock bound.
+            if (batch_layout.bypasses++ == 0) {
+                if (batch_layout.decisions == 0) {
+                    LOG_INFV(4, "batch_layout_mapper: inactive (%s)\n", reason);
+                } else {
+                    LOG_INFV(4, "batch_layout_mapper: bypass (%s)\n", reason);
+                }
+            }
+            return 0;
+        }
+        return limit;
+    }
