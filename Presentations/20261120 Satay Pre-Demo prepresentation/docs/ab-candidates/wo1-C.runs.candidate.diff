diff --git a/src/llama-event-recorder.cpp b/src/llama-event-recorder.cpp
new file mode 100644
index 0000000..d5c9634
--- /dev/null
+++ b/src/llama-event-recorder.cpp
@@ -0,0 +1,590 @@
+#include "llama-event-recorder.h"
+
+#include "llama-batch.h"
+#include "llama-hparams.h"
+#include "llama-impl.h"
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <charconv>
+#include <chrono>
+#include <cinttypes>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <limits>
+#include <memory>
+#include <mutex>
+#include <new>
+#include <string_view>
+
+#ifndef _WIN32
+#include <fcntl.h>
+#include <unistd.h>
+#endif
+
+namespace {
+
+using dispatch = llama_event_recorder_dispatch;
+
+constexpr size_t mib = 1024 * 1024;
+
+uint64_t now_ns() {
+    using namespace std::chrono;
+    return duration_cast<nanoseconds>(steady_clock::now().time_since_epoch()).count();
+}
+
+int parse_layer(std::string_view name, std::string_view prefix, char delimiter = '\0') {
+    if (name.substr(0, prefix.size()) != prefix) {
+        return -1;
+    }
+    name.remove_prefix(prefix.size());
+    if (name.empty() || name.front() < '0' || name.front() > '9') {
+        return -1;
+    }
+
+    int layer = -1;
+    const char * end = name.data() + name.size();
+    const auto result = std::from_chars(name.data(), end, layer);
+    if (result.ec != std::errc{} || layer < 0 || layer >= LLAMA_MAX_LAYERS) {
+        return -1;
+    }
+    return (delimiter == '\0' ? result.ptr == end : result.ptr != end && *result.ptr == delimiter) ? layer : -1;
+}
+
+// The pinned scheduler names an allocated cross-backend input copy backend#source#copy.
+std::string_view copied_weight_name(std::string_view name) {
+    const size_t begin = name.find('#');
+    const size_t end = name.rfind('#');
+    if (begin == end) {
+        return {};
+    }
+    return name.substr(begin + 1, end - begin - 1);
+}
+
+struct event_header {
+    size_t size;
+    uint64_t microbatch;
+    uint64_t dispatch_ns;
+    uint64_t route_ready_ns;
+    uint64_t dispatch_end_ns;
+    uint64_t bytes_transferred;
+    int32_t layer;
+    uint32_t n_rows;
+    uint32_t n_experts;
+};
+
+struct weight_copy {
+    const ggml_tensor * dst;
+    size_t bytes;
+};
+
+struct layer_observation {
+    const ggml_tensor * ids = nullptr;
+    const ggml_tensor * boundary = nullptr;
+    size_t offset = 0;
+    uint64_t additional_bytes = 0;
+    bool captured = false;
+    bool overflow = false;
+    bool complete = true;
+
+    // Four expert projections in the common case. Allow extra copies for other backends and adapters.
+    std::array<weight_copy, 16> copies;
+    size_t n_copies = 0;
+
+    void reset() {
+        ids = nullptr;
+        boundary = nullptr;
+        additional_bytes = 0;
+        captured = false;
+        overflow = false;
+        complete = true;
+        n_copies = 0;
+    }
+
+    void plan_copy(const ggml_tensor * dst) {
+        for (size_t i = 0; i < n_copies; ++i) {
+            if (copies[i].dst == dst) {
+                return;
+            }
+        }
+        if (n_copies == copies.size()) {
+            complete = false;
+            return;
+        }
+        // For a computed source the scheduler submits a full copy unless its host-weight callback handles it.
+        copies[n_copies++] = { dst, ggml_nbytes(dst) };
+    }
+
+    void observe_copy(const ggml_tensor * dst, size_t bytes, bool expert_weight) {
+        for (size_t i = 0; i < n_copies; ++i) {
+            if (copies[i].dst == dst) {
+                copies[i].bytes = bytes;
+                return;
+            }
+        }
+        // A split can copy an expert weight also used by a branch that is not executed.
+        if (expert_weight) {
+            additional_bytes += bytes;
+        }
+    }
+
+    uint64_t submitted_bytes() const {
+        uint64_t bytes = additional_bytes;
+        for (size_t i = 0; i < n_copies; ++i) {
+            bytes += copies[i].bytes;
+        }
+        return bytes;
+    }
+};
+
+const char * phase(bool is_prompt) {
+    return is_prompt ? "prefill" : "decode";
+}
+
+bool write_event(FILE * file, const event_header & event, const uint8_t * payload) {
+    dispatch::row first;
+    memcpy(&first, payload, sizeof(first));
+    bool same_request = true;
+    bool same_phase = true;
+    for (uint32_t i = 1; i < event.n_rows; ++i) {
+        dispatch::row row;
+        memcpy(&row, payload + i * sizeof(row), sizeof(row));
+        same_request &= row.request_id == first.request_id;
+        same_phase &= row.is_prompt == first.is_prompt;
+    }
+    if (fprintf(file, "{\"type\":\"event\",\"microbatch\":%" PRIu64 ",\"layer\":%d,\"request_id\":",
+                event.microbatch, event.layer) < 0) {
+        return false;
+    }
+    if ((same_request && first.request_id >= 0 ? fprintf(file, "%d", first.request_id) : fputs("null", file)) < 0) {
+        return false;
+    }
+    if (fprintf(file, ",\"phase\":\"%s\",\"dispatch_ns\":%" PRIu64 ",\"route_ready_ns\":%" PRIu64
+                ",\"dispatch_end_ns\":%" PRIu64 ",\"bytes_transferred\":%" PRIu64 ",\"rows\":[",
+                same_phase ? phase(first.is_prompt) : "mixed", event.dispatch_ns, event.route_ready_ns,
+                event.dispatch_end_ns, event.bytes_transferred) < 0) {
+        return false;
+    }
+
+    const uint8_t * ids = payload + event.n_rows * sizeof(dispatch::row);
+    for (uint32_t i = 0; i < event.n_rows; ++i) {
+        dispatch::row row;
+        memcpy(&row, payload + i * sizeof(row), sizeof(row));
+        if (fprintf(file, "%s{\"request_id\":", i == 0 ? "" : ",") < 0 ||
+                (row.request_id >= 0 ? fprintf(file, "%d", row.request_id) : fputs("null", file)) < 0 ||
+                fprintf(file, ",\"phase\":\"%s\",\"selected_expert_ids\":[", phase(row.is_prompt)) < 0) {
+            return false;
+        }
+        for (uint32_t j = 0; j < event.n_experts; ++j) {
+            int32_t id;
+            memcpy(&id, ids, sizeof(id));
+            ids += sizeof(id);
+            if (fprintf(file, "%s%d", j == 0 ? "" : ",", id) < 0) {
+                return false;
+            }
+        }
+        if (fputs("]}", file) < 0) {
+            return false;
+        }
+    }
+    return fputs("]}\n", file) >= 0 && fflush(file) == 0;
+}
+
+} // namespace
+
+struct llama_event_recorder {
+    llama_event_recorder(const char * path, void (*flush_log)()) : flush_log(flush_log) {
+        if (const char * error = open_output(path)) {
+            LLAMA_LOG_INFO("runtime_event_recorder: inactive (%s)\n", error);
+        } else {
+            LLAMA_LOG_INFO("runtime_event_recorder: active path=%s capacity_bytes=%zu\n", path, capacity);
+        }
+    }
+
+    ~llama_event_recorder() {
+        const std::lock_guard<std::mutex> lock(mutex);
+
+        uint64_t written = 0;
+        uint64_t bytes = 0;
+        if (file) {
+            const uint64_t flush_start_ns = now_ns();
+            bool ok = true;
+            for (size_t offset = 0; offset < used; ) {
+                event_header event;
+                memcpy(&event, ring.get() + offset, sizeof(event));
+                if (!write_event(file, event, ring.get() + offset + sizeof(event))) {
+                    ok = false;
+                    break;
+                }
+                ++written;
+                bytes += event.bytes_transferred;
+                offset += event.size;
+            }
+            if (ok) {
+                ok = fprintf(file, "{\"type\":\"summary\",\"expected\":%" PRIu64 ",\"written\":%" PRIu64
+                        ",\"lost\":%" PRIu64 ",\"overflow\":%" PRIu64 ",\"incomplete\":%" PRIu64
+                        ",\"failed_microbatches\":%" PRIu64 ",\"bytes_transferred\":%" PRIu64
+                        ",\"overhead_ns\":%" PRIu64 ",\"flush_ns\":%" PRIu64 "}\n",
+                        expected, written, expected - written, overflow, incomplete, failed_microbatches, bytes,
+                        overhead_ns, now_ns() - flush_start_ns) >= 0 && fflush(file) == 0;
+            }
+            if (fclose(file) != 0 || !ok) {
+                LLAMA_LOG_INFO("runtime_event_recorder: inactive (output write failed)\n");
+            }
+        }
+        LLAMA_LOG_INFO("runtime_event_recorder: stats events=%" PRIu64 " lost=%" PRIu64 " bytes=%" PRIu64 "\n",
+                written, expected - written, bytes);
+        if (flush_log) {
+            flush_log();
+        }
+    }
+
+    const char * open_output(const char * path) {
+#ifdef _WIN32
+        (void) path;
+        return "unsupported path platform";
+#else
+        if (!*path) {
+            return "empty output path";
+        }
+        size_t capacity_mib = 64;
+        if (const char * override_mib = std::getenv("LLAMA_EVENT_REC_MIB")) {
+            const char * end = override_mib + strlen(override_mib);
+            const auto result = std::from_chars(override_mib, end, capacity_mib);
+            if (result.ec != std::errc{} || result.ptr != end || capacity_mib == 0 ||
+                    capacity_mib > size_t(std::numeric_limits<ptrdiff_t>::max()) / mib) {
+                return "invalid LLAMA_EVENT_REC_MIB";
+            }
+        }
+        // Keep the fixed join and writer storage within the configured reservation.
+        capacity = capacity_mib * mib;
+        ring_capacity = capacity - sizeof(*this);
+        ring.reset(new (std::nothrow) uint8_t[ring_capacity]);
+        if (!ring) {
+            return "buffer allocation failed";
+        }
+
+        const int fd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+        if (fd < 0) {
+            const int error = errno;
+            ring.reset();
+            return error == EEXIST ? "output already exists" : "cannot create output";
+        }
+        file = fdopen(fd, "w");
+        if (!file) {
+            close(fd);
+            ring.reset();
+            return "cannot open output stream";
+        }
+        if (setvbuf(file, output_buffer, _IOFBF, sizeof(output_buffer)) != 0) {
+            fclose(file);
+            file = nullptr;
+            ring.reset();
+            return "cannot buffer output stream";
+        }
+        return nullptr;
+#endif
+    }
+
+    std::array<layer_observation, LLAMA_MAX_LAYERS> layers;
+    std::array<int32_t, LLAMA_MAX_LAYERS> boundaries;
+    size_t n_boundaries = 0;
+
+    void (*flush_log)();
+    std::mutex mutex;
+    FILE * file = nullptr;
+    char output_buffer[4096];
+    std::unique_ptr<uint8_t[]> ring;
+    size_t capacity = 0;
+    size_t ring_capacity = 0;
+    // A drop-newest ring with a single final drain never wraps before shutdown.
+    size_t used = 0;
+    uint64_t next_microbatch = 0;
+    uint64_t expected = 0;
+    uint64_t overflow = 0;
+    uint64_t incomplete = 0;
+    uint64_t failed_microbatches = 0;
+    uint64_t overhead_ns = 0;
+};
+
+namespace {
+
+static_assert(sizeof(llama_event_recorder) < mib, "recorder state must fit in the minimum capacity");
+thread_local dispatch * current_dispatch = nullptr;
+thread_local llama_event_recorder * current_observation = nullptr;
+
+struct ubatch_observation {
+    llama_event_recorder & recorder;
+    const llama_ubatch & ubatch;
+    size_t n_rows;
+    dispatch::row_callback get_row;
+    const void * rows;
+    ggml_backend_sched_eval_callback eval;
+    void * eval_data;
+    uint64_t microbatch;
+    uint64_t dispatch_ns;
+    uint64_t overhead_ns = 0;
+
+    bool plan(ggml_cgraph * graph) {
+        for (auto & layer : recorder.layers) {
+            layer.reset();
+        }
+        recorder.n_boundaries = 0;
+
+        auto ** nodes = ggml_graph_nodes(graph);
+        int32_t pending = -1;
+        int32_t routed_layer = -1;
+        bool routed = false;
+        const int n_nodes = ggml_graph_n_nodes(graph);
+        for (int i = 0; i < n_nodes; ++i) {
+            const ggml_tensor * node = nodes[i];
+            if (!(node->flags & GGML_TENSOR_FLAG_COMPUTE)) {
+                continue;
+            }
+            const int32_t il = parse_layer(node->name, "ffn_moe_topk-");
+            if (il >= 0) {
+                routed_layer = il;
+                auto & layer = recorder.layers[il];
+                if (layer.ids) {
+                    layer.complete = false;
+                } else {
+                    layer.ids = node;
+                    pending = il;
+                    routed = true;
+                }
+            }
+            if (pending >= 0) {
+                auto & layer = recorder.layers[pending];
+                const bool copies_ids = node->src[0] == layer.ids &&
+                    (node->op == GGML_OP_CONT || node->op == GGML_OP_CPY);
+                if (node->op == GGML_OP_MUL_MAT_ID || copies_ids ||
+                        parse_layer(node->name, "ffn_moe_slots-") == pending) {
+                    // Read before the first expert matmul or ID remap, after the router fusion.
+                    layer.boundary = nodes[i - 1];
+                    recorder.boundaries[recorder.n_boundaries++] = pending;
+                    pending = -1;
+                }
+            }
+            if (node->op == GGML_OP_MUL_MAT_ID) {
+                const auto name = copied_weight_name(node->src[0]->name);
+                const int32_t copy_layer = parse_layer(name, "blk.", '.');
+                if (copy_layer >= 0) {
+                    recorder.layers[copy_layer].plan_copy(node->src[0]);
+                } else if (!name.empty() && routed_layer >= 0) {
+                    recorder.layers[routed_layer].complete = false;
+                }
+            }
+        }
+
+        const auto less = std::less<const ggml_tensor *>{};
+        std::sort(recorder.boundaries.begin(), recorder.boundaries.begin() + recorder.n_boundaries,
+                [&](int32_t a, int32_t b) {
+                    return less(recorder.layers[a].boundary, recorder.layers[b].boundary);
+                });
+        return routed;
+    }
+
+    void capture(int32_t il) {
+        const uint64_t route_ready_ns = now_ns();
+        auto & layer = recorder.layers[il];
+        if (!layer.complete || layer.captured) {
+            return;
+        }
+
+        const ggml_tensor * ids = layer.ids;
+        if (!ubatch.data || ubatch.data->batch_idxs.size() != ubatch.n_tokens || ubatch.n_tokens == 0 ||
+                ids->type != GGML_TYPE_I32 || ids->ne[0] <= 0 || ids->ne[0] > LLAMA_MAX_EXPERTS ||
+                ids->ne[1] != ubatch.n_tokens || ids->ne[2] != 1 || ids->ne[3] != 1 || !ids->data ||
+                !(ids->view_src ? ids->view_src->buffer : ids->buffer)) {
+            return;
+        }
+        for (const int32_t i : ubatch.data->batch_idxs) {
+            if (i < 0 || size_t(i) >= n_rows) {
+                return;
+            }
+        }
+
+        const size_t id_row_bytes = size_t(ids->ne[0]) * sizeof(int32_t);
+        const size_t row_bytes = sizeof(dispatch::row) + id_row_bytes;
+        const size_t available = recorder.ring_capacity - recorder.used;
+        if (available < sizeof(event_header) || ubatch.n_tokens > (available - sizeof(event_header)) / row_bytes) {
+            layer.overflow = true;
+            return;
+        }
+
+        const event_header event = { sizeof(event_header) + ubatch.n_tokens * row_bytes,
+            microbatch, dispatch_ns, route_ready_ns, 0, 0, il, ubatch.n_tokens, uint32_t(ids->ne[0]) };
+        uint8_t * to = recorder.ring.get() + recorder.used;
+        memcpy(to, &event, sizeof(event));
+        to += sizeof(event);
+        for (const int32_t i : ubatch.data->batch_idxs) {
+            const dispatch::row row = get_row(rows, i);
+            memcpy(to, &row, sizeof(row));
+            to += sizeof(row);
+        }
+
+        if (ids->nb[0] == sizeof(int32_t) && (ubatch.n_tokens == 1 || ids->nb[1] >= id_row_bytes)) {
+            ggml_backend_tensor_get_2d(ids, to, 0, id_row_bytes, ubatch.n_tokens, ids->nb[1], id_row_bytes);
+        } else {
+            for (uint32_t row = 0; row < ubatch.n_tokens; ++row) {
+                for (int64_t col = 0; col < ids->ne[0]; ++col) {
+                    ggml_backend_tensor_get(ids, to, row * ids->nb[1] + col * ids->nb[0], sizeof(int32_t));
+                    to += sizeof(int32_t);
+                }
+            }
+        }
+        layer.offset = recorder.used;
+        layer.captured = true;
+        recorder.used += event.size;
+        overhead_ns += now_ns() - route_ready_ns;
+    }
+
+    static bool evaluate(ggml_tensor * node, bool ask, void * user_data) {
+        auto & self = *static_cast<ubatch_observation *>(user_data);
+        const auto & indices = self.recorder.boundaries;
+        const auto end = indices.begin() + self.recorder.n_boundaries;
+        const auto it = std::lower_bound(indices.begin(), end, node, [&](int32_t il, const ggml_tensor * t) {
+            return std::less<const ggml_tensor *>{}(self.recorder.layers[il].boundary, t);
+        });
+        const bool observe = it != end && self.recorder.layers[*it].boundary == node;
+        if (ask) {
+            self.caller_asked = self.eval && self.eval(node, true, self.eval_data);
+            return observe || self.caller_asked;
+        }
+        if (observe && !self.caller_stopped) {
+            self.capture(*it);
+        }
+        if (self.caller_asked && !self.eval(node, false, self.eval_data)) {
+            self.caller_stopped = true;
+            return false;
+        }
+        return true;
+    }
+
+    void finish(uint64_t end_ns) {
+        for (auto & layer : recorder.layers) {
+            if (!layer.ids) {
+                continue;
+            }
+            ++recorder.expected;
+            if (!layer.complete || !layer.captured) {
+                if (layer.overflow) {
+                    ++recorder.overflow;
+                } else {
+                    ++recorder.incomplete;
+                }
+                continue;
+            }
+            uint8_t * record = recorder.ring.get() + layer.offset;
+            event_header event;
+            memcpy(&event, record, sizeof(event));
+            event.dispatch_end_ns = end_ns;
+            event.bytes_transferred = layer.submitted_bytes();
+            memcpy(record, &event, sizeof(event));
+        }
+    }
+
+    bool caller_asked = false;
+    bool caller_stopped = false;
+};
+
+} // namespace
+
+llama_event_recorder * llama_event_recorder_dispatch::get(void (*flush_log)()) {
+    static llama_event_recorder * const enabled = [flush_log]() -> llama_event_recorder * {
+        const char * path = std::getenv("LLAMA_EVENT_REC");
+        if (!path) {
+            return nullptr;
+        }
+        static llama_event_recorder recorder(path, flush_log);
+        return recorder.file ? &recorder : nullptr;
+    }();
+    return enabled;
+}
+
+llama_event_recorder_dispatch::llama_event_recorder_dispatch(llama_event_recorder * recorder, llama_context * ctx,
+        size_t n_rows, row_callback get_row, const void * rows)
+    : recorder(recorder), ctx(ctx), n_rows(n_rows), get_row(get_row), rows(rows), previous(current_dispatch) {
+    current_dispatch = this;
+}
+
+llama_event_recorder_dispatch::~llama_event_recorder_dispatch() {
+    current_dispatch = previous;
+}
+
+llama_event_recorder_dispatch * llama_event_recorder_dispatch::current(const llama_context * ctx) {
+    return current_dispatch && current_dispatch->ctx == ctx ? current_dispatch : nullptr;
+}
+
+ggml_status llama_event_recorder_dispatch::compute(const llama_ubatch & ubatch, ggml_cgraph * graph,
+        ggml_backend_sched_t sched, ggml_backend_sched_eval_callback eval, void * eval_data,
+        ggml_backend_sched_copy_callback stock_copy, ggml_backend_sched_copy_callback observed_copy) {
+    const std::lock_guard<std::mutex> lock(recorder->mutex);
+    const uint64_t start_ns = now_ns();
+    ubatch_observation observation = {
+        *recorder, ubatch, n_rows, get_row, rows, eval, eval_data, recorder->next_microbatch++, start_ns,
+    };
+    if (!observation.plan(graph)) {
+        return ggml_backend_sched_graph_compute_async(sched, graph);
+    }
+
+    struct restore_callbacks {
+        ggml_backend_sched_t sched;
+        ggml_backend_sched_eval_callback eval;
+        void * eval_data;
+        ggml_backend_sched_copy_callback stock_copy;
+        llama_context * ctx;
+        llama_event_recorder * previous;
+        size_t & used;
+        const size_t start;
+        bool commit = false;
+
+        ~restore_callbacks() {
+            ggml_backend_sched_set_eval_callback(sched, eval, eval_data);
+            ggml_backend_sched_set_copy_callback(sched, stock_copy, ctx);
+            current_observation = previous;
+            if (!commit) {
+                used = start;
+            }
+        }
+    } restore = { sched, eval, eval_data, stock_copy, ctx, current_observation, recorder->used, recorder->used };
+
+    current_observation = recorder;
+    ggml_backend_sched_set_eval_callback(sched, ubatch_observation::evaluate, &observation);
+    ggml_backend_sched_set_copy_callback(sched, observed_copy, ctx);
+    const uint64_t compute_ns = now_ns();
+    const auto status = ggml_backend_sched_graph_compute_async(sched, graph);
+    const uint64_t end_ns = now_ns();
+    if (status == GGML_STATUS_SUCCESS) {
+        observation.finish(end_ns);
+        restore.commit = true;
+    } else {
+        ++recorder->failed_microbatches;
+    }
+    recorder->overhead_ns += compute_ns - start_ns + observation.overhead_ns + now_ns() - end_ns;
+    return status;
+}
+
+void llama_event_recorder_dispatch::copied_weight(const ggml_tensor * dst, size_t bytes) {
+    const auto name = copied_weight_name(dst->name);
+    const int32_t il = parse_layer(name, "blk.", '.');
+    if (il >= 0) {
+        const bool expert_weight = name.find("_exps.weight") != std::string_view::npos ||
+            name.find("_chexps.weight") != std::string_view::npos;
+        current_observation->layers[il].observe_copy(dst, bytes, expert_weight);
+    }
+}
+
+void llama_event_recorder_dispatch::copied_cache(const ggml_tensor * src, size_t bytes) {
+    int32_t il = parse_layer(src->name, "moe_cache.slot_map-");
+    if (il < 0) {
+        il = parse_layer(src->name, "moe_cache.slot_map_cpu-");
+    }
+    if (il >= 0) {
+        current_observation->layers[il].additional_bytes += bytes;
+    }
+}
