+// Tags apply only to the synchronous submission on this thread.
+class llama_event_recorder_dispatch {
+public:
+    struct row {
+        int32_t request_id;
+        bool is_prompt;
+    };
+
+    using row_callback = row (*)(const void * data, size_t i);
+
+    LLAMA_API static llama_event_recorder * get(void (*flush_log)());
+    LLAMA_API llama_event_recorder_dispatch(llama_event_recorder * recorder, llama_context * ctx,
+            size_t n_rows, row_callback get_row, const void * rows);
+    LLAMA_API ~llama_event_recorder_dispatch();
+
+    llama_event_recorder_dispatch(const llama_event_recorder_dispatch &) = delete;
+    llama_event_recorder_dispatch & operator=(const llama_event_recorder_dispatch &) = delete;
+
+    static llama_event_recorder_dispatch * current(const llama_context * ctx);
+
+    ggml_status compute(const llama_ubatch & ubatch, ggml_cgraph * graph, ggml_backend_sched_t sched,
+            ggml_backend_sched_eval_callback eval, void * eval_data,
+            ggml_backend_sched_copy_callback stock_copy, ggml_backend_sched_copy_callback observed_copy);
+
+    static void copied_weight(const ggml_tensor * dst, size_t bytes);
+    static void copied_cache(const ggml_tensor * src, size_t bytes);
+
+private:
+    llama_event_recorder * const recorder;
+    llama_context * const ctx;
+    const size_t n_rows;
+    const row_callback get_row;
+    const void * const rows;
+    llama_event_recorder_dispatch * previous = nullptr;
+};
