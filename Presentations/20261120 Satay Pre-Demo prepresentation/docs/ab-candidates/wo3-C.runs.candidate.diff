 common_init_result::common_init_result(common_params & params, bool model_only) :
     pimpl(new impl{}) {
     auto mparams = common_model_params_to_llama(params);
     auto cparams = common_context_params_to_llama(params);
 
-    common_fit_apply(params, mparams, cparams);
-
-    llama_model * model = common_model_load(params.model.get_paths(), mparams);
+    using gate_state = common_placement_plan_gate;
+    const auto gate = common_get_placement_plan_gate();
+    llama_model * model = nullptr;
+    if (gate == gate_state::unset) {
+        common_fit_apply(params, mparams, cparams);
+        model = common_model_load(params.model.get_paths(), mparams);
+    } else {
+        std::string reason = "LLAMA_PLACEMENT_PLAN must equal 1";
+        bool cancelled = false;
+        if (gate == gate_state::enabled) {
+            model = placement_plan_load(params, cparams, reason, cancelled);
+        }
+        if (!model) {
+            if (!cancelled) {
+                common_fit_apply(params, mparams, cparams);
+                model = common_model_load(params.model.get_paths(), mparams);
+            }
+            placement_plan_report(model, reason.c_str());
+        }
+    }
     if (model == NULL) {
         return;
     }
