+#pragma once
+
+#include "llama.h"
+
+#include <string>
+#include <utility>
+#include <vector>
+
+struct llama_placement_plan_readback {
+    const std::vector<std::pair<std::string, ggml_tensor *>> & tensors;
+    size_t host_weight_bytes;
+};
+
+// Internal readback after weight allocation. Tensor pointers are owned by the model.
+LLAMA_API llama_placement_plan_readback llama_placement_plan_inspect(const llama_model * model);
