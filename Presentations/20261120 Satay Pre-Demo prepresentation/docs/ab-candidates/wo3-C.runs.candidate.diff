+constexpr size_t placement_plan_max_bytes = 4 * 1024 * 1024;
+constexpr size_t placement_plan_max_rows = 4095;
+constexpr size_t placement_plan_max_pattern_bytes = 1024;
+constexpr size_t placement_plan_no_rule = SIZE_MAX;
+
+struct placement_plan_row {
+    std::string pattern;
+    std::string buft;
+};
+
+std::vector<placement_plan_row> placement_plan_read(const std::string & path) {
+    if (path.empty()) {
+        throw std::runtime_error("no placement plan file specified");
+    }
+
+    std::error_code ec;
+    const auto file_size = std::filesystem::file_size(std::filesystem::u8path(path), ec);
+    if (ec) {
+        throw std::runtime_error("cannot read placement plan file");
+    }
+    if (file_size > placement_plan_max_bytes) {
+        throw std::runtime_error("placement plan exceeds 4 MiB");
+    }
+    std::ifstream file(std::filesystem::u8path(path), std::ios::binary);
+    std::string input(placement_plan_max_bytes + 1, '\0');
+    file.read(input.data(), input.size());
+    if (file.bad() || !file.eof()) {
+        throw std::runtime_error(file ? "placement plan exceeds 4 MiB" : "cannot read placement plan file");
+    }
+    input.resize(file.gcount());
+    if (input.find('\0') != std::string::npos) {
+        throw std::runtime_error("invalid placement plan JSON");
+    }
+
+    using json = nlohmann::json;
+    using event = json::parse_event_t;
+    unsigned root_fields = 0;
+    unsigned row_fields = 0;
+    size_t row_count = 0;
+    auto check_schema = [&](int depth, event type, json & parsed) {
+        switch (type) {
+            case event::object_start:
+                if (depth == 0) {
+                    return true;
+                }
+                if (depth == 2 && ++row_count <= placement_plan_max_rows) {
+                    row_fields = 0;
+                    return true;
+                }
+                break;
+            case event::array_start:
+                if (depth == 1) {
+                    return true;
+                }
+                break;
+            case event::key: {
+                const auto & key = parsed.get_ref<const std::string &>();
+                const unsigned field = depth == 1 ?
+                        (key == "version" ? 1 : key == "overrides" ? 2 : 0) :
+                        (key == "pattern" ? 1 : key == "buft" ? 2 : 0);
+                auto & fields = depth == 1 ? root_fields : row_fields;
+                if (field && !(fields & field)) {
+                    fields |= field;
+                    return true;
+                }
+                break;
+            }
+            case event::value:
+                if ((depth == 1 && parsed.is_number_integer()) || (depth == 3 && parsed.is_string())) {
+                    return true;
+                }
+                break;
+            case event::object_end:
+                if ((depth == 0 ? root_fields : row_fields) == 3) {
+                    return true;
+                }
+                break;
+            case event::array_end:
+                return true;
+        }
+        throw std::runtime_error("invalid placement plan schema or too many overrides");
+    };
+
+    json doc;
+    try {
+        doc = json::parse(input, check_schema);
+    } catch (const json::exception &) {
+        throw std::runtime_error("invalid placement plan JSON");
+    }
+    if (!doc.is_object() || !doc["version"].is_number_integer() || !doc["overrides"].is_array()) {
+        throw std::runtime_error("invalid placement plan schema");
+    }
+    if (doc["version"] != 1) {
+        throw std::runtime_error("unsupported placement plan version");
+    }
+
+    std::vector<placement_plan_row> rows;
+    rows.reserve(row_count);
+    for (auto & row : doc["overrides"]) {
+        auto & pattern = row["pattern"].get_ref<std::string &>();
+        auto & buft = row["buft"].get_ref<std::string &>();
+        if (pattern.empty() || buft.empty() || pattern.find('\0') != std::string::npos || buft.find('\0') != std::string::npos) {
+            throw std::runtime_error("empty field or embedded NUL in placement override");
+        }
+        // The stock libstdc++ regex compiler can recurse once per pattern character.
+        if (pattern.size() > placement_plan_max_pattern_bytes) {
+            throw std::runtime_error("placement override regex exceeds 1024 bytes");
+        }
+        rows.push_back({std::move(pattern), std::move(buft)});
+    }
+    return rows;
+}
+
+struct placement_plan_exit_stats {
+    size_t assigned;
+    size_t stock;
+
+    ~placement_plan_exit_stats() {
+        LOG_INF("weight_placement_planner: stats assigned=%zu stock=%zu\n", assigned, stock);
+        common_log_flush(common_log_main());
+    }
+};
+
+void placement_plan_report(const llama_model * model, const char * reason, size_t cap_bytes = 0,
+        const std::vector<llama_model_tensor_buft_override> & overrides = {}, const std::vector<size_t> & matches = {}) {
+    // A server can unload and reload its model. Report the initial result once per process.
+    static const placement_plan_exit_stats stats = [&] {
+        if (reason) {
+            LOG_INF("weight_placement_planner: inactive (%s)\n", reason);
+        }
+        if (!model) {
+            return placement_plan_exit_stats{0, 0};
+        }
+
+        const auto readback = llama_placement_plan_inspect(model);
+        if (!reason) {
+            LOG_INF("weight_placement_planner: active cap_bytes=%zu peak_bytes=%zu\n", cap_bytes, readback.host_weight_bytes);
+        }
+
+        std::unordered_set<std::string_view> seen;
+        std::array<size_t, 2> assigned = {};
+        std::array<size_t, 2> stock = {};
+        for (size_t i = 0; i < readback.tensors.size(); ++i) {
+            const auto & [name, tensor] = readback.tensors[i];
+            const size_t rule = reason ? placement_plan_no_rule : matches[i];
+            const bool expert = name.find("_exps.") != std::string::npos || name.find("_exps_") != std::string::npos;
+            if (seen.insert(name).second) {
+                ++(rule == placement_plan_no_rule ? stock : assigned)[expert];
+            }
+            if (!reason) {
+                auto actual = ggml_backend_buffer_get_type(tensor->buffer);
+                const char * planned = rule == placement_plan_no_rule ? "stock" : ggml_backend_buft_name(overrides[rule].buft);
+                const auto quoted_name = nlohmann::json(name).dump(-1, ' ', false, nlohmann::json::error_handler_t::replace);
+                LOG_INF("weight_placement_planner: assignment name=%s planned=%s actual=%s bytes=%zu\n",
+                        quoted_name.c_str(), planned, ggml_backend_buft_name(actual), ggml_nbytes(tensor));
+            }
+        }
+        if (!reason) {
+            LOG_INF("weight_placement_planner: assignment class=expert assigned=%zu stock=%zu\n", assigned[1], stock[1]);
+            LOG_INF("weight_placement_planner: assignment class=other assigned=%zu stock=%zu\n", assigned[0], stock[0]);
+        }
+        return placement_plan_exit_stats{assigned[0] + assigned[1], stock[0] + stock[1]};
+    }();
+    (void) stats;
+}
+
+std::vector<size_t> placement_plan_match(const llama_placement_plan_readback & readback,
+        const std::vector<llama_model_tensor_buft_override> & overrides, size_t stock_rows, size_t plan_rows) {
+    for (const auto & [_, tensor] : readback.tensors) {
+        if (!tensor->buffer) {
+            throw std::runtime_error("model tensor has no allocated buffer");
+        }
+    }
+    std::vector<size_t> matches(readback.tensors.size(), placement_plan_no_rule);
+    for (size_t rule = stock_rows; rule < stock_rows + plan_rows; ++rule) {
+        const std::regex regex(overrides[rule].pattern);
+        for (size_t i = 0; i < readback.tensors.size(); ++i) {
+            if (std::regex_search(readback.tensors[i].first, regex)) {
+                if (matches[i] != placement_plan_no_rule) {
+                    throw std::runtime_error("placement override patterns overlap");
+                }
+                matches[i] = rule;
+            }
+        }
+    }
+    for (size_t rule = 0; rule < stock_rows; ++rule) {
+        const std::regex regex(overrides[rule].pattern);
+        for (size_t i = 0; i < readback.tensors.size(); ++i) {
+            if (matches[i] != placement_plan_no_rule && std::regex_search(readback.tensors[i].first, regex)) {
+                throw std::runtime_error("placement plan conflicts with a stock tensor override");
+            }
+        }
+    }
+    return matches;
+}
+
+llama_model * placement_plan_load(common_params & params, llama_context_params & cparams,
+        std::string & reason, bool & cancelled) {
+    try {
+        const auto rows = placement_plan_read(params.placement_plan);
+        if (params.no_alloc) {
+            throw std::runtime_error("placement plan requires allocated model weights");
+        }
+        const auto sentinel = std::find_if(params.tensor_buft_overrides.begin(), params.tensor_buft_overrides.end(),
+                [](const auto & entry) { return entry.pattern == nullptr; });
+        const size_t stock_rows = sentinel - params.tensor_buft_overrides.begin();
+        if (stock_rows + rows.size() >= llama_max_tensor_buft_overrides()) {
+            throw std::runtime_error("too many combined tensor overrides");
+        }
+
+        auto staged = params;
+        auto & overrides = staged.tensor_buft_overrides;
+        overrides.resize(stock_rows);
+        const auto types = common_tensor_buffer_types();
+        for (const auto & row : rows) {
+            const auto buft = types.find(row.buft);
+            if (buft == types.end()) {
+                throw std::runtime_error("unknown placement buffer type");
+            }
+            const std::regex regex(row.pattern);
+            overrides.push_back({row.pattern.c_str(), buft->second});
+        }
+        overrides.resize(llama_max_tensor_buft_overrides(), {nullptr, nullptr});
+
+        size_t free_bytes = 0;
+        size_t cap_bytes = 0;
+        if (auto * cpu = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU)) {
+            ggml_backend_dev_memory(cpu, &free_bytes, &cap_bytes);
+        }
+        if (cap_bytes == 0) {
+            throw std::runtime_error("host memory capacity unavailable");
+        }
+
+        auto mparams = common_model_params_to_llama(staged);
+        auto cparams_staged = cparams;
+        common_fit_apply(staged, mparams, cparams_staged);
+
+        // A caller cancellation must also cancel the stock retry.
+        struct progress_state {
+            llama_progress_callback callback;
+            void * user_data;
+            bool & cancelled;
+        } progress = {mparams.progress_callback, mparams.progress_callback_user_data, cancelled};
+        if (progress.callback) {
+            mparams.progress_callback_user_data = &progress;
+            mparams.progress_callback = [](float value, void * user_data) {
+                auto & state = *static_cast<progress_state *>(user_data);
+                state.cancelled = !state.callback(value, state.user_data);
+                return !state.cancelled;
+            };
+        }
+        llama_model_ptr model(common_model_load(staged.model.get_paths(), mparams));
+        if (!model) {
+            reason = cancelled ? "model load cancelled" : "model load with placement plan failed";
+            return nullptr;
+        }
+
+        const auto readback = llama_placement_plan_inspect(model.get());
+        const auto matches = placement_plan_match(readback, overrides, stock_rows, rows.size());
+        placement_plan_report(model.get(), nullptr, cap_bytes, overrides, matches);
+        std::copy(std::begin(staged.tensor_split), std::end(staged.tensor_split), std::begin(params.tensor_split));
+        cparams = cparams_staged;
+        return model.release();
+    } catch (const std::regex_error &) {
+        reason = "invalid placement regex";
+    } catch (const std::runtime_error & error) {
+        reason = error.what();
+    }
+    return nullptr;
+}
+
+} // namespace
