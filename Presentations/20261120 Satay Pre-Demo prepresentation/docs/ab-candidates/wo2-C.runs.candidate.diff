@@ -0,0 +1,508 @@
+#include "llama-expert-weight-cache.h"
+
+#include "ggml-cpp.h"
+#include "llama-impl.h"
+#include "llama-model.h"
+
+#include <algorithm>
+#include <array>
+#include <charconv>
+#include <cinttypes>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <map>
+#include <mutex>
+#include <new>
+#include <utility>
+#include <vector>
+
+#ifdef __linux__
+#    include <fcntl.h>
+#    include <limits.h>
+#    include <sys/stat.h>
+#    include <sys/sysmacros.h>
+#    include <unistd.h>
+#endif
+
+namespace {
+
+constexpr size_t mib = 1024 * 1024;
+constexpr size_t headroom = 1024 * mib; // stock --fit-target default
+constexpr size_t n_slices = 4;
+
+// Satay's CUDA device and the host share a memory pool. Reserve the admitted caps
+// for all live contexts, including capacity they have yet to allocate.
+std::mutex pool_mutex;
+size_t pool_reserved = 0;
+
+size_t requested_capacity() {
+    const char * value = std::getenv("LLAMA_EXPERT_CACHE_MIB");
+    if (value == nullptr) {
+        return 64 * mib;
+    }
+    const char * end = value + std::strlen(value);
+    size_t count = 0;
+    const auto parsed = std::from_chars(value, end, count);
+    if (parsed.ec != std::errc{} || parsed.ptr != end || count > std::numeric_limits<size_t>::max() / mib) {
+        return 0;
+    }
+    return count * mib;
+}
+
+bool contains(const void * base, size_t size, const void * data, size_t length) {
+    const auto start = reinterpret_cast<uintptr_t>(base);
+    const auto addr  = reinterpret_cast<uintptr_t>(data);
+    return base && addr >= start && addr - start <= size && length <= size - (addr - start);
+}
+
+bool is_mapped_gguf(const void * data, size_t size) {
+#ifdef __linux__
+    std::unique_ptr<FILE, decltype(&std::fclose)> maps(std::fopen("/proc/self/maps", "r"), std::fclose);
+    if (!maps) {
+        return false;
+    }
+
+    const auto addr = reinterpret_cast<uintptr_t>(data);
+    char line[PATH_MAX + 128];
+    while (std::fgets(line, sizeof(line), maps.get())) {
+        uintptr_t lo, hi;
+        uint64_t offset, inode;
+        unsigned major_id, minor_id;
+        char perms[5];
+        int path_pos = 0;
+        if (std::sscanf(line, "%" SCNxPTR "-%" SCNxPTR " %4s %" SCNx64 " %x:%x %" SCNu64 " %n",
+                    &lo, &hi, perms, &offset, &major_id, &minor_id, &inode, &path_pos) != 7 ||
+                addr < lo || addr >= hi) {
+            continue;
+        }
+        char * path = line + path_pos;
+        char * newline = std::strchr(path, '\n');
+        if (size > hi - addr || std::strcmp(perms, "r--s") != 0 || inode == 0 || path[0] != '/' || !newline) {
+            return false;
+        }
+        *newline = '\0';
+
+        const int fd = open(path, O_RDONLY | O_CLOEXEC | O_NONBLOCK);
+        if (fd < 0) {
+            return false;
+        }
+        struct stat st;
+        char magic[4];
+        const bool matched = fstat(fd, &st) == 0 && S_ISREG(st.st_mode) && st.st_size >= 4 &&
+            uint64_t(st.st_ino) == inode && major(st.st_dev) == major_id && minor(st.st_dev) == minor_id &&
+            offset <= uint64_t(st.st_size) && addr - lo <= uint64_t(st.st_size) - offset &&
+            size <= uint64_t(st.st_size) - offset - (addr - lo) &&
+            pread(fd, magic, sizeof(magic), 0) == sizeof(magic) && std::memcmp(magic, "GGUF", sizeof(magic)) == 0;
+        close(fd);
+        return matched;
+    }
+#else
+    (void) data;
+    (void) size;
+#endif
+    return false;
+}
+
+ggml_tensor byte_span(ggml_backend_buffer_t buffer, void * data, size_t size) {
+    ggml_tensor tensor = {};
+    tensor.type = GGML_TYPE_I8;
+    tensor.ne[0] = size;
+    tensor.nb[0] = 1;
+    for (int i = 1; i < GGML_MAX_DIMS; ++i) {
+        tensor.ne[i] = 1;
+        tensor.nb[i] = size;
+    }
+    tensor.buffer = buffer;
+    tensor.data = data;
+    return tensor;
+}
+
+void copy_device(ggml_backend_t backend, ggml_tensor & src, ggml_tensor & dst) {
+    // Both spans are in default buffers of this CUDA backend. CUDA's copy
+    // callback queues a device-to-device copy on the split's compute stream.
+    ggml_backend_tensor_copy_async(backend, backend, &src, &dst);
+}
+
+} // namespace
+
+struct llama_expert_weight_cache::impl {
+    using key = std::pair<size_t, int64_t>; // model layer, expert number
+
+    struct expert {
+        std::array<ggml_backend_buffer_ptr, n_slices> slices;
+        size_t charge = 0;
+        uint64_t operation = 0;
+        uint64_t recency = 0;
+        bool reused = false;
+    };
+
+    enum class provenance : uint8_t { unchecked, mapped, unavailable };
+    using layer_sources = std::array<provenance, n_slices>;
+
+    impl(const llama_model & model, size_t requested) : model(model), requested(requested) {}
+
+    ~impl() {
+        clear();
+    }
+
+    void clear() {
+        entries.clear();
+        sources.reset();
+        used = 0;
+        if (capacity != 0) {
+            std::lock_guard<std::mutex> lock(pool_mutex);
+            pool_reserved -= capacity;
+            capacity = 0;
+        }
+    }
+
+    bool choose_backend(ggml_backend_t candidate, const ggml_tensor * dst) {
+        auto * device = ggml_backend_get_device(candidate);
+        auto * reg = device ? ggml_backend_dev_backend_reg(device) : nullptr;
+        auto * buffer = dst->view_src ? dst->view_src->buffer : dst->buffer;
+        return (!backend || backend == candidate) && reg && std::strcmp(ggml_backend_reg_name(reg), "CUDA") == 0 &&
+            buffer && ggml_backend_buffer_get_type(buffer) == ggml_backend_dev_buffer_type(device) &&
+            !ggml_backend_buffer_is_host(buffer) &&
+            contains(ggml_backend_buffer_get_base(buffer), ggml_backend_buffer_get_size(buffer), dst->data, ggml_nbytes(dst));
+    }
+
+    bool reserve(ggml_backend_t candidate) {
+        std::lock_guard<std::mutex> lock(pool_mutex);
+
+        size_t free, total;
+        ggml_backend_dev_memory(ggml_backend_get_device(candidate), &free, &total);
+        const size_t available = free > headroom ? free - headroom : 0;
+        const size_t unreserved = available > pool_reserved ? available - pool_reserved : 0;
+        const size_t cap = std::min(requested, unreserved / mib * mib);
+
+        if (cap < sizeof(impl) || model.layers.size() > (cap - sizeof(impl)) / sizeof(layer_sources)) {
+            return false;
+        }
+        sources.reset(new layer_sources[model.layers.size()]{});
+        capacity = cap;
+        pool_reserved += cap;
+        backend = candidate;
+        used = sizeof(impl) + model.layers.size() * sizeof(layer_sources);
+        peak = used;
+        return true;
+    }
+
+    bool locate(const ggml_tensor * src, size_t & layer, size_t & tensor) const {
+        const char * name = src->name;
+        if (std::strncmp(name, "blk.", 4) != 0) {
+            return false;
+        }
+        const auto parsed = std::from_chars(name + 4, name + std::strlen(name), layer);
+        if (parsed.ec != std::errc{} || *parsed.ptr != '.' || layer >= model.layers.size()) {
+            return false;
+        }
+        // Match the original model tensor. Expert weights use the normal loader, without lazy remapping.
+        const auto & l = model.layers[layer];
+        const std::array<const ggml_tensor *, n_slices> weights = {
+            l.ffn_gate_up_exps, l.ffn_gate_exps, l.ffn_up_exps, l.ffn_down_exps,
+        };
+        const auto it = std::find(weights.begin(), weights.end(), src);
+        tensor = it - weights.begin();
+        return it != weights.end();
+    }
+
+    bool make_room(key id, size_t charge, size_t entry_charge) {
+        auto required = [&] {
+            return entries.count(id) ? charge : charge + entry_charge;
+        };
+        if (required() <= capacity - used) {
+            return true;
+        }
+        size_t reclaimable = 0;
+        for (const auto & pair : entries) {
+            if (pair.second.operation <= completed) {
+                reclaimable += pair.second.charge;
+            }
+        }
+        // Include the node if this demand's expert must itself be evicted.
+        const auto current = entries.find(id);
+        const bool may_evict_current = current != entries.end() && current->second.operation <= completed;
+        if ((may_evict_current ? charge + entry_charge : required()) > capacity - used + reclaimable) {
+            return false;
+        }
+
+        while (required() > capacity - used) {
+            auto victim = entries.end();
+            for (auto it = entries.begin(); it != entries.end(); ++it) {
+                if (it->second.operation <= completed &&
+                        (victim == entries.end() || it->second.recency < victim->second.recency)) {
+                    victim = it;
+                }
+            }
+            if (victim == entries.end()) {
+                return false;
+            }
+            used -= victim->second.charge;
+            entries.erase(victim);
+            ++evictions;
+        }
+        return true;
+    }
+
+    void lease(expert & item, bool hit) {
+        if (item.operation != operation) {
+            item.operation = operation;
+            item.reused = false;
+            ++leases;
+        }
+        if (hit && !item.reused) {
+            item.reused = true;
+            ++reuses;
+        }
+        item.recency = ++clock;
+    }
+
+    bool stage(key id, size_t tensor, ggml_tensor & src) {
+        const size_t size = ggml_nbytes(&src);
+        const auto buft = ggml_backend_buffer_get_type(src.buffer);
+        const size_t alignment = std::max<size_t>(4096, ggml_backend_buft_get_alignment(buft));
+        // Include the map node and buffer wrappers in the accounted bytes.
+        constexpr size_t entry_charge = sizeof(key) + sizeof(expert) + 64;
+        constexpr size_t buffer_overhead = 256;
+        if (size > capacity || alignment > capacity) {
+            return true;
+        }
+        const size_t padding = (alignment - size % alignment) % alignment;
+        if (padding > capacity - size || buffer_overhead > capacity - size - padding) {
+            return true;
+        }
+        const size_t allocation = size + padding;
+        const size_t charge = allocation + buffer_overhead;
+        auto it = entries.find(id);
+        if (it != entries.end() && it->second.slices[tensor]) {
+            return true;
+        }
+
+        if (entry_charge > capacity - charge || !make_room(id, charge, entry_charge)) {
+            return true;
+        }
+
+        auto [position, inserted] = entries.try_emplace(id);
+        auto & item = position->second;
+        if (inserted) {
+            item.charge = entry_charge;
+            used += entry_charge;
+            peak = std::max(peak, used);
+        }
+        ggml_backend_buffer_ptr buffer(ggml_backend_buft_alloc_buffer(buft, allocation));
+        if (!buffer || ggml_backend_buffer_get_size(buffer.get()) != allocation) {
+            return false;
+        }
+
+        auto dst = byte_span(buffer.get(), ggml_backend_buffer_get_base(buffer.get()), size);
+        item.slices[tensor] = std::move(buffer);
+        item.charge += charge;
+        used += charge;
+        peak = std::max(peak, used);
+
+        lease(item, false);
+        copy_device(backend, src, dst);
+        staged_bytes += size;
+        return true;
+    }
+
+    const llama_model & model;
+    const size_t requested;
+    ggml_backend_t backend = nullptr;
+    std::unique_ptr<layer_sources[]> sources;
+    std::map<key, expert> entries;
+    const char * no_use = "no eligible selected-expert copy";
+    bool submitting = false;
+    bool active = false;
+    size_t capacity = 0;
+    size_t used = 0;
+    size_t peak = 0;
+    // Submissions are serial, but several operations can still be in flight.
+    // Every expert last leased after this watermark is pinned.
+    uint64_t operation = 0;
+    uint64_t completed = 0;
+    uint64_t clock = 0;
+    uint64_t leases = 0;
+    uint64_t reuses = 0;
+    uint64_t evictions = 0;
+    uint64_t saved = 0;
+    uint64_t staged_bytes = 0;
+};
+
+llama_expert_weight_cache::llama_expert_weight_cache() = default;
+
+llama_expert_weight_cache::~llama_expert_weight_cache() {
+    if (!enabled) {
+        return;
+    }
+    if (!inactive && state && !state->active) {
+        disable(state->no_use);
+    }
+    LLAMA_LOG_INFO("expert_weight_cache: stats leases=%" PRIu64 " reuses=%" PRIu64 " evictions=%" PRIu64
+            " bytes_copied_saved=%" PRIu64 " peak_bytes=%zu\n",
+            state ? state->leases : 0, state ? state->reuses : 0, state ? state->evictions : 0,
+            state ? state->saved : 0, state ? state->peak : 0);
+    if (state && state->active) {
+        LLAMA_LOG_DEBUG("expert_weight_cache: transfers staged_device_bytes=%" PRIu64 " reused_device_bytes=%" PRIu64 "\n",
+                state->staged_bytes, state->saved);
+    }
+}
+
+void llama_expert_weight_cache::disable(const char * reason) {
+    inactive = reason;
+    LLAMA_LOG_INFO("expert_weight_cache: inactive (%s)\n", reason);
+}
+
+void llama_expert_weight_cache::configure(const llama_model & model, bool native_cache) {
+    const char * gate = std::getenv("LLAMA_EXPERT_CACHE");
+    const bool enabled = gate != nullptr && std::strcmp(gate, "1") == 0;
+    // Memory-fit probes do not submit graphs or own weight backing.
+    if (!enabled || model.no_alloc()) {
+        return;
+    }
+    this->enabled = true;
+
+    if (native_cache) {
+        disable("native MoE cache enabled");
+        return;
+    }
+    const size_t requested = requested_capacity();
+    if (requested == 0) {
+        disable("invalid or zero LLAMA_EXPERT_CACHE_MIB");
+        return;
+    }
+
+    state.reset(new (std::nothrow) impl(model, requested));
+    if (!state) {
+        disable("cache state allocation failed");
+    }
+}
+
+void llama_expert_weight_cache::begin_operation() {
+    if (available()) {
+        ++state->operation;
+        state->submitting = true;
+    }
+}
+
+void llama_expert_weight_cache::end_operation() {
+    if (state) {
+        state->submitting = false;
+    }
+}
+
+void llama_expert_weight_cache::synchronized() {
+    if (state) {
+        state->completed = state->operation;
+        if (inactive) {
+            state->clear();
+        }
+    }
+}
+
+bool llama_expert_weight_cache::copy(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst,
+        int64_t first, int64_t last) {
+    if (!available() || !state->submitting) {
+        return false;
+    }
+    auto & cache = *state;
+
+    size_t layer, tensor;
+    if (!cache.locate(src, layer, tensor)) {
+        return false;
+    }
+    if (!cache.choose_backend(backend, dst)) {
+        cache.no_use = "unsupported scheduler copy backend";
+        return false;
+    }
+
+    const size_t size = src->nb[2];
+    const size_t bytes = ggml_nbytes(src);
+    if (src->type != dst->type || !ggml_are_same_shape(src, dst) || !ggml_are_same_stride(src, dst) ||
+            first < 0 || last < first || last >= src->ne[2] ||
+            src->ne[3] != 1 || size == 0 || size > size_t(std::numeric_limits<int64_t>::max()) ||
+            uint64_t(src->ne[2]) > bytes / size) {
+        return false;
+    }
+
+    try {
+        auto verify_source = [&] {
+            return src->buffer && !src->view_src &&
+                    contains(ggml_backend_buffer_get_base(src->buffer), ggml_backend_buffer_get_size(src->buffer),
+                             src->data, bytes) && is_mapped_gguf(src->data, bytes);
+        };
+        if (!cache.backend) {
+            if (!verify_source()) {
+                cache.no_use = "expert weights are not file-backed GGUF mappings";
+                return false;
+            }
+            if (!cache.reserve(backend)) {
+                disable("no memory budget available");
+                return false;
+            }
+            cache.sources[layer][tensor] = impl::provenance::mapped;
+        }
+
+        auto & source = cache.sources[layer][tensor];
+        if (source == impl::provenance::unchecked) {
+            source = verify_source() ? impl::provenance::mapped : impl::provenance::unavailable;
+        }
+        if (source != impl::provenance::mapped) {
+            return false;
+        }
+
+        auto * dst_buffer = dst->view_src ? dst->view_src->buffer : dst->buffer;
+        auto dst_span = [&](int64_t expert) {
+            return byte_span(dst_buffer, static_cast<char *>(dst->data) + expert * size, size);
+        };
+        auto upload = [&](int64_t begin, int64_t end, size_t padding) {
+            const size_t count = (end - begin) * size + padding;
+            if (count > 0) {
+                const size_t offset = begin * size;
+                ggml_backend_tensor_set_async(backend, dst, static_cast<const char *>(src->data) + offset, offset, count);
+            }
+        };
+
+        int64_t next = first;
+        for (int64_t e = first; e <= last; ++e) {
+            const auto it = cache.entries.find({layer, e});
+            if (it == cache.entries.end() || !it->second.slices[tensor]) {
+                continue;
+            }
+
+            upload(next, e, 0);
+            auto * buffer = it->second.slices[tensor].get();
+            auto staged = byte_span(buffer, ggml_backend_buffer_get_base(buffer), size);
+            auto target = dst_span(e);
+            cache.lease(it->second, true);
+            copy_device(backend, staged, target);
+            cache.saved += size;
+            next = e + 1;
+        }
+        // MMQ reads past the last expert of a run. Leave its stock padding upload in place.
+        const size_t padding = last < src->ne[2] - 1 ? std::min<size_t>(size, 512) : 0;
+        upload(next, last + 1, padding);
+
+        // The split has not started yet. Staging from its destination keeps misses
+        // on the stock upload path and orders future hits after this copy.
+        for (int64_t e = first; e <= last; ++e) {
+            auto staged_from = dst_span(e);
+            if (!cache.stage({layer, e}, tensor, staged_from)) {
+                disable("staged buffer allocation failed");
+                return true;
+            }
+            if (!cache.active && cache.leases != 0) {
+                cache.active = true;
+                LLAMA_LOG_INFO("expert_weight_cache: active cap_mib=%zu backend=%s\n",
+                        cache.capacity / mib, ggml_backend_name(backend));
+            }
+        }
+        cache.no_use = "no expert slice fits the capacity";
+        return true;
+    } catch (const std::bad_alloc &) {
+        disable("cache metadata allocation failed");
+        return false;
+    }
+}
