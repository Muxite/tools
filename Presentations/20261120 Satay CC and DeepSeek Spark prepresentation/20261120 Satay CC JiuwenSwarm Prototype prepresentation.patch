+"""Plan and verify a pinned text prompt policy through CCv2."""
+
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+
+ENGINE_COMMIT = "cf34d311332e362198f0a410c466d1e940287d02"
+SCOPE = "single-slot-causal-text-completion"
+CAP_VARIABLE = "LLAMA_PREFILL_PROMPT_CAP"
+PATCH = Path(__file__).with_name("llama-cf34d311-prompt-batch-layout.patch")
+
+
+def record(value, fields, name):
+    if not isinstance(value, dict) or set(value) != set(fields.split()):
+        raise ValueError(f"{name} must contain {fields}")
+    return value
+
+
+def integer(value, limit, name):
+    if type(value) is not int or not 1 <= value <= limit:
+        raise ValueError(f"{name} must be an integer in [1, {limit}]")
+    return value
+
+
+def policy(spec):
+    record(spec, "engine_commit scope parallel n_batch n_ubatch prompt_cap", "spec")
+    if spec["engine_commit"] != ENGINE_COMMIT or spec["scope"] != SCOPE:
+        raise ValueError("Unsupported engine revision or completion scope")
+    integer(spec["parallel"], 1, "parallel")
+    batch = integer(spec["n_batch"], 2**31 - 1, "n_batch")
+    ubatch = integer(spec["n_ubatch"], batch, "n_ubatch")
+    cap = integer(spec["prompt_cap"], ubatch, "prompt_cap")
+    return {
+        "engine_commit": ENGINE_COMMIT,
+        "scope": SCOPE,
+        "argv": ["--batch-size", str(batch), "--ubatch-size", str(ubatch), "--parallel", "1"],
+        "env": {CAP_VARIABLE: str(cap)},
+        "patch_sha256": hashlib.sha256(PATCH.read_bytes()).hexdigest(),
+    }
+
+
+def verify(spec, fixtures):
+    run_policy = policy(spec)
+    cap = int(run_policy["env"][CAP_VARIABLE])
+    if not isinstance(fixtures, list) or not fixtures:
+        raise ValueError("fixtures must be a nonempty list")
+    results = []
+    names = set()
+    for fixture in fixtures:
+        record(fixture, "name prompt_tokens chunks stock candidate", "fixture")
+        name = fixture["name"]
+        if not isinstance(name, str) or not name or name in names:
+            raise ValueError("Fixture names must be unique nonempty strings")
+        names.add(name)
+        prompt_tokens = integer(fixture["prompt_tokens"], 2**31 - 1, "prompt_tokens")
+        chunks = fixture["chunks"]
+        if not isinstance(chunks, list) or not chunks:
+            raise ValueError(f"{name}: no prompt batch rows observed")
+        for chunk in chunks:
+            integer(chunk, cap, f"{name} chunk size")
+        if sum(chunks) != prompt_tokens:
+            raise ValueError(f"{name}: batch rows do not account for the full processed prompt")
+        if prompt_tokens > cap and max(chunks) != cap:
+            raise ValueError(f"{name}: long fixture never reached the requested cap")
+        for arm in ("stock", "candidate"):
+            output = record(fixture[arm], "tokens stop", arm)
+            if (not isinstance(output["tokens"], list) or not output["tokens"]
+                    or any(type(token) is not int or token < 0 for token in output["tokens"])
+                    or not isinstance(output["stop"], str) or not output["stop"]):
+                raise ValueError(f"{name}: incomplete {arm} token or stop evidence")
+        if fixture["stock"] != fixture["candidate"]:
+            raise ValueError(f"{name}: greedy token IDs or stop reason differ")
+        results.append({"name": name, "prompt_tokens": prompt_tokens, "chunks": chunks})
+    if not any(row["prompt_tokens"] > cap for row in results):
+        raise ValueError("At least one fixture must cross the cap")
+    return {"exact_greedy_parity": True, "prompt_cap": cap, "fixtures": results}
+
+
+def main():
+    packet = json.load(sys.stdin)
+    inputs = packet["inputs"]
+    try:
+        if packet["capability"] == "plan":
+            outputs = {"policy": policy(inputs["spec"])}
+        elif packet["capability"] == "verify":
+            outputs = {"verification": verify(inputs["spec"], inputs["fixtures"])}
+        else:
+            raise ValueError("Unsupported capability")
+        result = {"outcome": "ok", "outputs": outputs}
+    except ValueError as error:
+        result = {"outcome": "error", "error": {"code": "INVALID_INPUT", "message": str(error)}}
+    print(json.dumps(result))
+
+
+if __name__ == "__main__":
+    main()
