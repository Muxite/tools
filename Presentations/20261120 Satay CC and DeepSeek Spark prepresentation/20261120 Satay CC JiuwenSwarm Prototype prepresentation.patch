@@ -0,0 +1,190 @@
+"""Exercise the capsule and its pinned server patch on a small local model."""
+
+import argparse
+import json
+import os
+import re
+import socket
+import subprocess
+import time
+from pathlib import Path
+from urllib.error import URLError
+from urllib.request import Request, urlopen
+
+from jiuwenswarm.ccv2.ccv2 import Host
+
+from run import CAP_VARIABLE, ENGINE_COMMIT, SCOPE
+
+
+PORT = 5175
+ROWS = re.compile(r"prompt_batch_layout: tokens = (\d+), cap = (\d+)")
+PROMPTS = {
+    "short": "The capital of France is",
+    "medium": (
+        "Finish the simple arithmetic sequence. Each integer increases by one. "
+        "Continue with integers only: 1, 2, 3, 4, 5,"
+    ),
+    "long": (
+        "The following sentences are background for a reading exercise. "
+        + "The little green train arrives at the station early each Monday. " * 11
+        + "Complete this sentence with the name of the country: Paris is the capital of"
+    ),
+}
+
+
+def request(route, payload=None, timeout=45):
+    data = None if payload is None else json.dumps(payload).encode()
+    req = Request(f"http://127.0.0.1:{PORT}/{route}", data, {"Content-Type": "application/json"})
+    with urlopen(req, timeout=timeout) as response:
+        return json.load(response)
+
+
+def write_json(path, value):
+    path.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")
+
+
+def wait_ready(process):
+    deadline = time.monotonic() + 120
+    while time.monotonic() < deadline and process.poll() is None:
+        try:
+            if request("health", timeout=2).get("status") == "ok":
+                return
+        except (URLError, TimeoutError):
+            pass
+        time.sleep(0.25)
+    raise RuntimeError(f"Server did not become ready (exit={process.poll()})")
+
+
+def stop(process):
+    if process.poll() is None:
+        process.terminate()
+        try:
+            process.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            process.wait()
+
+
+def run_arm(base, binary, model, arm, flags, setting=None):
+    with socket.socket() as probe:
+        if probe.connect_ex(("127.0.0.1", PORT)) == 0:
+            raise RuntimeError(f"Port {PORT} is already in use")
+    env = os.environ.copy()
+    env.pop(CAP_VARIABLE, None)
+    if setting is not None:
+        env[CAP_VARIABLE] = str(setting)
+    command = [
+        str(binary), "--host", "127.0.0.1", "--port", str(PORT), "--model", str(model),
+        "--gpu-layers", "0", "--ctx-size", "512", "--threads", "2",
+        "--ctx-checkpoints", "0", *flags,
+    ]
+    log = base / f"{arm}.log"
+    observations = {}
+    with log.open("wb", buffering=0) as output, log.open("rb") as reader:
+        process = subprocess.Popen(command, env=env, stdout=output, stderr=subprocess.STDOUT)
+        try:
+            if arm == "invalid":
+                if process.wait(timeout=20) == 0:
+                    raise RuntimeError("Invalid startup returned success")
+                if "must be a positive 32-bit integer" not in log.read_text(errors="replace"):
+                    raise RuntimeError("Server did not reject the malformed cap")
+                return {}
+            wait_ready(process)
+            for name, prompt in PROMPTS.items():
+                reader.seek(0, os.SEEK_END)
+                payload = {
+                    "prompt": prompt, "n_predict": 8, "temperature": 0, "seed": 47,
+                    "cache_prompt": False, "return_tokens": True, "stream": False,
+                }
+                response = request("completion", payload)
+                rows = ROWS.findall(reader.read().decode(errors="replace"))
+                if setting is None and rows:
+                    raise RuntimeError(f"{arm}/{name}: disabled policy emitted engagement")
+                if any(int(cap) != setting for _, cap in rows):
+                    raise RuntimeError(f"{arm}/{name}: runtime reported a different cap")
+                if response["truncated"] or not response["stop"]:
+                    raise RuntimeError(f"{arm}/{name}: fixture did not complete")
+                processed = response.pop("timings")["prompt_n"]
+                if processed != response["tokens_evaluated"]:
+                    raise RuntimeError(f"{arm}/{name}: fixture did not process the full uncached prompt")
+                observations[name] = {
+                    "request": payload,
+                    "response": response,
+                    "chunks": [int(tokens) for tokens, _ in rows],
+                    "prompt_tokens": response["tokens_evaluated"],
+                    "output": {"tokens": response["tokens"], "stop": response["stop_type"]},
+                }
+        finally:
+            stop(process)
+    write_json(base / f"{arm}.json", observations)
+    return observations
+
+
+def invoke(host, release, capability, inputs, receipt_path):
+    receipt = host.call(release, capability, inputs, grants=["process.exec"])
+    write_json(receipt_path, receipt)
+    if not receipt["outputs"]:
+        raise RuntimeError(f"CC {capability} failed. See {receipt_path}")
+    return receipt["outputs"]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("stage", choices=("prepare", "stock", "candidate"))
+    parser.add_argument("--work", required=True, type=Path)
+    parser.add_argument("--binary", type=Path)
+    parser.add_argument("--model", type=Path)
+    args = parser.parse_args()
+
+    base = args.work
+    base.mkdir(parents=True, exist_ok=True)
+    host = Host(base / "cc-store")
+    release = host.prepare(Path(__file__).resolve().parent)
+    spec = {"engine_commit": ENGINE_COMMIT, "scope": SCOPE, "parallel": 1,
+            "n_batch": 128, "n_ubatch": 128, "prompt_cap": 16}
+    initial = invoke(host, release, "plan", {"spec": spec}, base / f"plan-{args.stage}.receipt.json")["policy"]
+    if args.stage == "prepare":
+        material = host.material(release, "server_patch")
+        if material["artifact"]["sha256"] != initial["patch_sha256"]:
+            raise RuntimeError("Sealed patch digest mismatch")
+        write_json(base / "server-patch.material.json", material)
+        (base / "server.patch").write_bytes(host.artifact_path(material["artifact"]).read_bytes())
+        return
+    if args.model is None or args.binary is None:
+        parser.error("--binary and --model are required for runtime checks")
+    if args.stage == "stock":
+        run_arm(base, args.binary, args.model, "stock", initial["argv"])
+        return
+
+    stock = json.loads((base / "stock.json").read_text(encoding="utf-8"))
+    rollback = run_arm(base, args.binary, args.model, "rollback", initial["argv"])
+    for name, reference in stock.items():
+        if any(rollback[name][key] != reference[key] for key in ("output", "prompt_tokens")):
+            raise RuntimeError(f"Rollback differs from the independently built stock fixture {name}")
+    run_arm(base, args.binary, args.model, "invalid", initial["argv"], setting="16x")
+
+    for cap in (16, 32):
+        spec["prompt_cap"] = cap
+        arm = f"cap{cap}"
+        trial = invoke(host, release, "plan", {"spec": spec}, base / f"plan-{arm}.receipt.json")["policy"]
+        candidate = run_arm(base, args.binary, args.model, arm, trial["argv"], int(trial["env"][CAP_VARIABLE]))
+        fixtures = []
+        for name, observation in candidate.items():
+            if stock[name]["prompt_tokens"] != observation["prompt_tokens"]:
+                raise RuntimeError(f"{arm}/{name}: processed prompt lengths differ")
+            full, remainder = divmod(observation["prompt_tokens"], cap)
+            expected_chunks = [cap] * full
+            if remainder:
+                expected_chunks.append(remainder)
+            if observation["chunks"] != expected_chunks:
+                raise RuntimeError(f"{arm}/{name}: expected {expected_chunks}, observed {observation['chunks']}")
+            fixtures.append({
+                "name": name, "prompt_tokens": observation["prompt_tokens"], "chunks": observation["chunks"],
+                "stock": stock[name]["output"], "candidate": observation["output"],
+            })
+        verdict = invoke(host, release, "verify", {"spec": spec, "fixtures": fixtures}, base / f"verify-{arm}.receipt.json")
+        print(json.dumps(verdict["verification"]), flush=True)
+
+
+if __name__ == "__main__":
+    main()
