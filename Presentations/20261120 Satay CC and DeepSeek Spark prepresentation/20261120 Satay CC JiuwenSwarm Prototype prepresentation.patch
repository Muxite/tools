+"""Exercise the route-capture and existing cache methodology CCs on four Granite requests."""
+
+import argparse
+import json
+import subprocess
+from pathlib import Path
+
+from jiuwenswarm.ccv2.ccv2 import Host
+
+
+PROMPTS = {
+    "reference": "Complete this sentence: the capital of France is",
+    "arithmetic": "Continue the sequence of square numbers: 1, 4, 9, 16,",
+    "prose": "Write one sentence about a train arriving in the rain:",
+    "code": "In Python, write the first line of a function that adds two numbers:",
+}
+
+
+def write_json(path, record):
+    path.write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")
+
+
+def run_probe(out, probe, model, request, prompt, mode):
+    with (out / f"{request}-{mode}.log").open("w", encoding="utf-8") as log:
+        process = subprocess.run([str(probe), str(model), mode, prompt], stdout=subprocess.PIPE, stderr=log,
+                                 text=True, check=True, timeout=90)
+    (out / f"{request}-{mode}.txt").write_text(process.stdout, encoding="utf-8")
+    return process.stdout
+
+
+def invoke(host, out, release, capability, inputs, label, expected="succeeded"):
+    receipt = host.call(release, capability, inputs, grants=["process.exec"], timeout=120)
+    write_json(out / f"{label}.receipt.json", receipt)
+    if receipt["state"] != expected:
+        raise RuntimeError(f"{label}: expected {expected}, got {receipt['state']}: {receipt['diagnostics']}")
+    return receipt
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    for field in ("work", "probe", "model", "geometry", "route-bundle", "cache-bundle"):
+        parser.add_argument(f"--{field}", required=True, type=Path)
+    args = parser.parse_args()
+
+    out = args.work
+    out.mkdir(parents=True, exist_ok=True)
+    host = Host(out / "cc-store")
+    route_release = host.prepare(args.route_bundle)
+    cache_release = host.prepare(args.cache_bundle)
+    geometry = json.loads(args.geometry.read_text(encoding="utf-8"))
+    events, routes = [], {}
+    for request, prompt in PROMPTS.items():
+        inputs = {
+            "request_id": request, "geometry": geometry,
+            "reference": run_probe(out, args.probe, args.model, request, prompt, "off"),
+            "capture": run_probe(out, args.probe, args.model, request, prompt, "on"),
+        }
+        adapted = invoke(host, out, route_release, "adapt", inputs, f"{request}-adapt")["outputs"]
+        routes[request] = adapted["verification"]
+        for event in adapted["cache_lab_input"]["trace"]:
+            events.append({**event, "seq": len(events)})
+        if request == "reference":
+            captured_rows = inputs["capture"].splitlines()
+            missing_row = captured_rows[:-1]
+            if not captured_rows[-1].startswith("R "):
+                raise RuntimeError("Missing-layer test did not select a route row")
+            rejection = invoke(host, out, route_release, "adapt",
+                               inputs | {"capture": "\n".join(missing_row)}, "missing-route-negative", expected="failed")
+            if rejection["reason"] != "INVALID_INPUT":
+                raise RuntimeError("Expected typed invalid input for missing layer coverage")
+
+    replay_input = {"trace": events, "layers": geometry["layers"], "experts": geometry["experts"]}
+    validated = invoke(host, out, cache_release, "validate", {"inputs": replay_input}, "cache-validate")
+    validation = validated["outputs"]["result"]
+    if validation["requests"] != len(PROMPTS) or validation["events"] != len(events):
+        raise RuntimeError("Cache lab did not validate the whole trace")
+    replays = {}
+    for mib in (64, 256, 512, 768):
+        call = invoke(host, out, cache_release, "replay", {
+            "inputs": replay_input | {"capacity_bytes": mib * 1024**2, "policy": "lru"},
+        }, f"lru-{mib}mib")
+        result = call["outputs"]["result"]
+        if result["hits"] + result["misses"] != len(events) or result["peak_resident_bytes"] > mib * 1024**2:
+            raise RuntimeError("Replay output violated the event or budget accounting")
+        replays[str(mib)] = {key: result[key] for key in ("hits", "misses", "peak_resident_bytes")}
+    prediction = invoke(host, out, cache_release, "predict", {
+        "inputs": replay_input | {"evaluation_requests": ["code"], "top_k": geometry["top_k"]},
+    }, "frozen-code-holdout")["outputs"]["result"]
+    if {row["request"] for row in prediction["predictions"]} != {"code"}:
+        raise RuntimeError("Prediction output crossed the request holdout")
+    summary = {
+        "route_release": route_release, "cache_release": cache_release, "captures": routes,
+        "validation": validation, "lru_replays_mib": replays, "heldout_request": "code",
+        "prediction": {key: prediction[key] for key in ("evaluation_groups", "evaluation_events", "hits")},
+    }
+    write_json(out / "summary.json", summary)
+    print(json.dumps(summary))
+
+
+if __name__ == "__main__":
+    main()
