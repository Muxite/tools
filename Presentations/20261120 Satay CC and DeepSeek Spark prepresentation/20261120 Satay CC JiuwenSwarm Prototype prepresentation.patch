diff --git a/jiuwenswarm/factory/ccs/expert_route_capture/expert_route_probe.cpp b/jiuwenswarm/factory/ccs/expert_route_capture/expert_route_probe.cpp
new file mode 100644
--- /dev/null
+++ b/jiuwenswarm/factory/ccs/expert_route_capture/expert_route_probe.cpp
@@ -0,0 +1,119 @@
+#include "llama.h"
+#include "ggml-backend.h"
+
+#include <charconv>
+#include <cstdio>
+#include <memory>
+#include <string_view>
+#include <vector>
+
+struct route_capture {
+    int position = -1;
+    bool invalid_tensor = false;
+};
+
+static bool capture_selected_experts(ggml_tensor * tensor, bool ask, void * user_data) {
+    auto & capture = *static_cast<route_capture *>(user_data);
+    constexpr std::string_view prefix = "ffn_moe_topk-";
+    const std::string_view name(tensor->name);
+    if (capture.position < 0 || name.substr(0, prefix.size()) != prefix) {
+        return false;
+    }
+    if (ask) {
+        return true;
+    }
+
+    int layer = -1;
+    const auto parsed = std::from_chars(name.data() + prefix.size(), name.data() + name.size(), layer);
+    // The probe evaluates one decode token at a time. One expert-ID row is expected.
+    if (parsed.ec != std::errc{} || parsed.ptr != name.data() + name.size() || layer < 0
+            || tensor->type != GGML_TYPE_I32 || tensor->nb[0] != sizeof(int32_t)
+            || tensor->ne[0] < 1 || tensor->ne[0] > 512
+            || tensor->ne[1] != 1 || tensor->ne[2] != 1 || tensor->ne[3] != 1) {
+        capture.invalid_tensor = true;
+        return true;
+    }
+
+    std::vector<int32_t> experts(tensor->ne[0]);
+    ggml_backend_tensor_get(tensor, experts.data(), 0, experts.size() * sizeof(int32_t));
+    std::printf("R %d %d", capture.position, layer);
+    for (const auto expert : experts) {
+        std::printf(" %d", expert);
+    }
+    std::puts("");
+    return true;
+}
+
+static bool run(const char * path, bool enable_capture, std::string_view text) {
+    constexpr int batch_limit = 64;
+    constexpr int generated_count = 8;
+    auto model_params = llama_model_default_params();
+    model_params.n_gpu_layers = 0;
+    std::unique_ptr<llama_model, decltype(&llama_model_free)> model(
+            llama_model_load_from_file(path, model_params), llama_model_free);
+    if (!model) {
+        return false;
+    }
+
+    const llama_vocab * vocab = llama_model_get_vocab(model.get());
+    std::vector<llama_token> prompt(batch_limit);
+    const int prompt_size = llama_tokenize(vocab, text.data(), static_cast<int>(text.size()),
+            prompt.data(), prompt.size(), true, false);
+    if (prompt_size < 1 || prompt_size > batch_limit) {
+        std::fputs("Expected a nonempty prompt of at most 64 tokens\n", stderr);
+        return false;
+    }
+
+    route_capture capture;
+    auto ctx_params = llama_context_default_params();
+    ctx_params.n_ctx = 128;
+    ctx_params.n_batch = batch_limit;
+    ctx_params.n_ubatch = batch_limit;
+    ctx_params.n_threads = 2;
+    ctx_params.n_threads_batch = 2;
+    ctx_params.offload_kqv = false;
+    if (enable_capture) {
+        ctx_params.cb_eval = capture_selected_experts;
+        ctx_params.cb_eval_user_data = &capture;
+    }
+    std::unique_ptr<llama_context, decltype(&llama_free)> context(
+            llama_init_from_model(model.get(), ctx_params), llama_free);
+    if (!context || llama_decode(context.get(), llama_batch_get_one(prompt.data(), prompt_size)) != 0) {
+        return false;
+    }
+    std::unique_ptr<llama_sampler, decltype(&llama_sampler_free)> sampler(
+            llama_sampler_init_greedy(), llama_sampler_free);
+    if (!sampler) {
+        return false;
+    }
+
+    char architecture[64] = {};
+    const int length = llama_model_meta_val_str(model.get(), "general.architecture", architecture, sizeof(architecture));
+    if (length <= 0 || length >= static_cast<int>(sizeof(architecture))) {
+        return false;
+    }
+    std::printf("M %s %d\n", architecture, llama_model_n_layer(model.get()));
+    std::printf("P %d\n", prompt_size);
+    for (int step = 0; step < generated_count; ++step) {
+        auto token = llama_sampler_sample(sampler.get(), context.get(), -1);
+        capture.position = prompt_size + step;
+        std::printf("G %d %d\n", capture.position, token);
+        if (llama_decode(context.get(), llama_batch_get_one(&token, 1)) != 0 || capture.invalid_tensor) {
+            std::fputs("Could not evaluate a single decode token with the expected expert tensor\n", stderr);
+            return false;
+        }
+    }
+    llama_synchronize(context.get());
+    return true;
+}
+
+int main(int argc, char ** argv) {
+    if (argc != 4 || (std::string_view(argv[2]) != "on" && std::string_view(argv[2]) != "off")) {
+        std::fputs("Usage: expert-route-probe MODEL {on|off} PROMPT\n", stderr);
+        return 2;
+    }
+    llama_backend_init();
+    const bool ok = run(argv[1], std::string_view(argv[2]) == "on", argv[3]);
+    llama_backend_free();
+    return ok ? 0 : 1;
+}
diff --git a/jiuwenswarm/factory/ccs/expert_route_capture/gguf_geometry.py b/jiuwenswarm/factory/ccs/expert_route_capture/gguf_geometry.py
new file mode 100644
--- /dev/null
+++ b/jiuwenswarm/factory/ccs/expert_route_capture/gguf_geometry.py
@@ -0,0 +1,39 @@
+"""Read and check the packed expert tensor geometry using the pinned GGUF reader."""
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from gguf import GGUFReader
+
+
+def geometry(model):
+    reader = GGUFReader(model)
+    architecture = reader.get_field("general.architecture").contents()
+    if architecture != "granitemoe":
+        raise ValueError("This geometry adapter supports granitemoe")
+    layers = int(reader.get_field("granitemoe.block_count").contents())
+    experts = int(reader.get_field("granitemoe.expert_count").contents())
+    top_k = int(reader.get_field("granitemoe.expert_used_count").contents())
+    tensors = {tensor.name: tensor for tensor in reader.tensors}
+    layer_bytes = []
+    for layer in range(layers):
+        total = 0
+        for role in ("gate", "up", "down"):
+            tensor = tensors.get(f"blk.{layer}.ffn_{role}_exps.weight")
+            if (tensor is None or len(tensor.shape) != 3 or int(tensor.shape[2]) != experts
+                    or tensor.n_bytes <= 0 or tensor.n_bytes % experts != 0):
+                raise ValueError(f"Invalid packed {role} expert tensor at layer {layer}")
+            total += int(tensor.n_bytes) // experts
+        layer_bytes.append(total)
+    with Path(model).open("rb") as stream:
+        model_sha256 = hashlib.file_digest(stream, "sha256").hexdigest()
+    return {"architecture": architecture, "layers": layers, "experts": experts, "top_k": top_k,
+            "expert_bytes": layer_bytes, "model_sha256": model_sha256}
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("model", type=Path)
+    print(json.dumps(geometry(parser.parse_args().model)))
diff --git a/jiuwenswarm/factory/ccs/expert_route_capture/run.py b/jiuwenswarm/factory/ccs/expert_route_capture/run.py
new file mode 100644
--- /dev/null
+++ b/jiuwenswarm/factory/ccs/expert_route_capture/run.py
@@ -0,0 +1,115 @@
+"""CCv2 entry point for the pinned decode-only route observation."""
+
+import hashlib
+import json
+import re
+import sys
+from pathlib import Path
+
+
+ENGINE_COMMIT = "cf34d311332e362198f0a410c466d1e940287d02"
+ARCHITECTURE = "granitemoe"
+DECODE_STEPS = 8
+PROBE = Path(__file__).with_name("expert_route_probe.cpp")
+
+
+def parse_probe(raw):
+    if len(raw) > 200_000:
+        raise ValueError("Probe output exceeds the diagnostic limit")
+    metadata, prompt = None, None
+    tokens, routes = [], []
+    for line in raw.splitlines():
+        record, *fields = line.split()
+        if record == "M" and len(fields) == 2 and metadata is None:
+            metadata = fields[0], int(fields[1])
+        elif record == "P" and len(fields) == 1 and prompt is None:
+            prompt = int(fields[0])
+        elif record == "G" and len(fields) == 2:
+            tokens.append(tuple(map(int, fields)))
+        elif record == "R" and len(fields) >= 3:
+            position, layer, *experts = map(int, fields)
+            routes.append((position, layer, experts))
+        else:
+            raise ValueError("Unexpected probe record")
+    if metadata is None or prompt is None or not 1 <= prompt <= 64:
+        raise ValueError("Missing or invalid model or prompt metadata")
+    if [pos for pos, _ in tokens] != list(range(prompt, prompt + DECODE_STEPS)) or any(tok < 0 for _, tok in tokens):
+        raise ValueError("Expected a complete series of fixed-step greedy tokens")
+    return metadata, prompt, tokens, routes
+
+
+def count(value, maximum, label):
+    if type(value) is not int or not 1 <= value <= maximum:
+        raise ValueError(f"Invalid {label}")
+    return value
+
+
+def adapt(reference, capture, geometry, request_id):
+    fields = {"architecture", "layers", "experts", "top_k", "expert_bytes", "model_sha256"}
+    if not isinstance(geometry, dict) or set(geometry) != fields or geometry["architecture"] != ARCHITECTURE:
+        raise ValueError("Expected pinned Granite MoE geometry")
+    layers = count(geometry["layers"], 256, "layer count")
+    experts = count(geometry["experts"], 512, "expert count")
+    top_k = count(geometry["top_k"], experts, "selected expert count")
+    sizes = geometry["expert_bytes"]
+    if not isinstance(sizes, list) or len(sizes) != layers:
+        raise ValueError("A packed expert byte size is required for every layer")
+    for size in sizes:
+        count(size, 2**53, "packed expert byte size")
+    digest = geometry["model_sha256"]
+    if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
+        raise ValueError("Invalid model SHA-256")
+    if not request_id.strip() or len(request_id) > 96 or DECODE_STEPS * layers * top_k > 100_000:
+        raise ValueError("Invalid request identifier or excessive replay size")
+
+    baseline = parse_probe(reference)
+    observed = parse_probe(capture)
+    if baseline[3] or baseline[:3] != observed[:3] or observed[0] != (ARCHITECTURE, layers):
+        raise ValueError("Capture must preserve the uncaptured model, prompt and greedy token IDs")
+    positions = {position for position, _ in observed[2]}
+    groups, trace = set(), []
+    previous_position = -1
+    for position, layer, choices in observed[3]:
+        key = (position, layer)
+        if position < previous_position or position not in positions or not 0 <= layer < layers or key in groups:
+            raise ValueError("Unexpected or duplicate decode position and layer")
+        if len(choices) != top_k or len(set(choices)) != top_k or any(not 0 <= expert < experts for expert in choices):
+            raise ValueError("Invalid selected expert set")
+        previous_position = position
+        groups.add(key)
+        for expert in choices:
+            trace.append({"seq": len(trace), "request": request_id, "token": position,
+                          "layer": layer, "expert": expert, "bytes": sizes[layer]})
+    if len(groups) != DECODE_STEPS * layers:
+        raise ValueError("Missing decode layer coverage")
+    return {
+        "verification": {"exact_greedy_parity": True, "mode": "decode-only-logical-demand",
+                         "positions": len(positions), "groups": len(groups), "events": len(trace),
+                         "model_sha256": digest},
+        "cache_lab_input": {"layers": layers, "experts": experts, "trace": trace},
+    }
+
+
+def main():
+    packet = json.load(sys.stdin)
+    inputs = packet["inputs"]
+    try:
+        if packet["capability"] == "plan":
+            if inputs["engine_commit"] != ENGINE_COMMIT:
+                raise ValueError("Unsupported llama.cpp engine revision")
+            outputs = {"capture": {"engine_commit": ENGINE_COMMIT, "architecture": ARCHITECTURE,
+                                   "phase": "decode-only", "decode_steps": DECODE_STEPS,
+                                   "tensor": "ffn_moe_topk-<layer>", "acceleration": "cpu",
+                                   "probe_sha256": hashlib.sha256(PROBE.read_bytes()).hexdigest()}}
+        elif packet["capability"] == "adapt":
+            outputs = adapt(**inputs)
+        else:
+            raise ValueError("Unsupported capability")
+        result = {"outcome": "ok", "outputs": outputs}
+    except ValueError as error:
+        result = {"outcome": "error", "error": {"code": "INVALID_INPUT", "message": str(error)}}
+    print(json.dumps(result))
+
+
+if __name__ == "__main__":
+    main()
