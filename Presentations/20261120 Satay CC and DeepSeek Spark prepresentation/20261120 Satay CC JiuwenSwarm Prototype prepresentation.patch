+"""Verify the single-slot policy bypass against an independent two-slot stock server.
+
+Add the deployed prompt_batch_layout directory to PYTHONPATH to reuse the
+single-slot pilot's localhost transport and process handling.
+"""
+
+import argparse
+import json
+import os
+import socket
+import subprocess
+from pathlib import Path
+
+from jiuwenswarm.ccv2.ccv2 import Host
+
+from satay_smoke import CAP_VARIABLE, ENGINE_COMMIT, PORT, ROWS, SCOPE, invoke, request, stop, wait_ready, write_json
+
+
+PROMPT = (
+    "The engine will process both a short prompt and a longer prompt. "
+    "Each slot should produce its own independent completion while the scheduler "
+    "continues to admit prompt tokens and evaluate the decode token of the other slot. "
+    "The little green train leaves the station again the next day."
+)
+
+
+def run_arm(base, arm, binary, model, policy, payload=None):
+    with socket.socket() as probe:
+        if probe.connect_ex(("127.0.0.1", PORT)) == 0:
+            raise RuntimeError(f"Port {PORT} is already in use")
+    env = os.environ.copy()
+    env.pop(CAP_VARIABLE, None)
+    env["LD_LIBRARY_PATH"] = str(binary.parent)
+    if arm == "overlap-candidate":
+        env.update(policy["env"])
+    command = [
+        str(binary), "--model", str(model), "--host", "127.0.0.1", "--port", str(PORT),
+        "--gpu-layers", "0", "--threads", "2", "--ctx-size", "512",
+        "--cont-batching", "--ctx-checkpoints", "0", *policy["argv"], "--parallel", "2",
+    ]
+    log = base / f"{arm}.log"
+    with log.open("wb", buffering=0) as output:
+        process = subprocess.Popen(command, env=env, stdout=output, stderr=subprocess.STDOUT)
+        try:
+            wait_ready(process)
+            if payload is None:
+                tokens = request("tokenize", {"content": PROMPT, "add_special": True})["tokens"]
+                if len(tokens) < 35:
+                    raise RuntimeError("Tokenizer did not provide enough IDs for the fixture")
+                payload = {
+                    "prompt": [tokens[:8], tokens[:35]], "cache_prompt": False, "n_predict": 4,
+                    "ignore_eos": True, "temperature": 0, "seed": 47, "return_tokens": True, "stream": False,
+                }
+            responses = sorted(request("completion", payload), key=lambda response: response["index"])
+        finally:
+            stop(process)
+    if len(responses) != 2 or responses[0]["id_slot"] == responses[1]["id_slot"]:
+        raise RuntimeError(f"{arm}: expected two distinct live slots")
+    for expected, response in zip((8, 35), responses):
+        processed = response.pop("timings")["prompt_n"]
+        if response["truncated"] or not response["stop"] or processed != expected:
+            raise RuntimeError(f"{arm}: unexpected uncached prompt processing")
+        if response["tokens_evaluated"] != expected or len(response["tokens"]) != 4:
+            raise RuntimeError(f"{arm}: unexpected input or generated token count")
+    log_text = log.read_text(encoding="utf-8", errors="replace")
+    if "retrying with smaller batch size" in log_text:
+        raise RuntimeError(f"{arm}: KV cache retried with a smaller batch")
+    write_json(base / f"{arm}.json", {"request": payload, "responses": responses})
+    return payload, responses, log_text
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--work", type=Path, required=True)
+    parser.add_argument("--bundle", type=Path, required=True)
+    parser.add_argument("--stock", type=Path, required=True)
+    parser.add_argument("--candidate", type=Path, required=True)
+    parser.add_argument("--model", type=Path, required=True)
+    args = parser.parse_args()
+    base = args.work
+    base.mkdir(parents=True, exist_ok=True)
+    host = Host(base / "cc-store")
+    release = host.prepare(args.bundle)
+    spec = {"engine_commit": ENGINE_COMMIT, "scope": SCOPE, "parallel": 1,
+            "n_batch": 64, "n_ubatch": 32, "prompt_cap": 16}
+    policy = invoke(host, release, "plan", {"spec": spec}, base / "overlap-plan.receipt.json")["policy"]
+    payload, stock, stock_log = run_arm(base, "overlap-stock", args.stock, args.model, policy)
+    _, candidate, candidate_log = run_arm(base, "overlap-candidate", args.candidate, args.model, policy, payload)
+    if ROWS.search(stock_log) or ROWS.search(candidate_log):
+        raise RuntimeError("A two-slot server unexpectedly emitted cap engagement rows")
+    if "disabled unless exactly one slot is configured" not in candidate_log:
+        raise RuntimeError("Guarded server did not report its disabled policy")
+    keys = ("tokens", "stop_type", "stopping_word")
+    if any(tuple(a[k] for k in keys) != tuple(b[k] for k in keys) for a, b in zip(stock, candidate)):
+        raise RuntimeError("Mixed workload changed exact greedy outputs or stops")
+    proof = {"cc_release": release, "exact_greedy_parity": True, "cap_multi_slot_bypassed": True,
+             "prompt_tokens": [8, 35], "generated_tokens": [4, 4]}
+    write_json(base / "overlap-verdict.json", proof)
+    print(json.dumps(proof))
+
+
+if __name__ == "__main__":
+    main()
