flowchart TB
FE["<b>FRONTEND · OPEN [?]</b><br/>IN · a human: text, files<br/>DOES · open: CLI to begin?<br/>OUT · request + attachments"]:::box_unk
subgraph HOT ["M1 · ONE TASK"]
    subgraph ROW1 ["understand the request"]
        direction LR
        INT["<b>INTAKE [M1]</b><br/>IN · request + attachments<br/>DOES · takes the request in<br/>OUT · RawIntent"]:::box_hot
        ITN["<b>INTENT COMPILATION [M1]</b><br/>IN · RawIntent<br/>DOES · what did they ask for?<br/>OUT · accepted IntentIR"]:::box_hot
        RQC["<b>REQUIREMENT COMPILATION [M1]</b><br/>IN · accepted IntentIR<br/>DOES · what would satisfy them?<br/>OUT · RequirementIR v2"]:::box_hot
        CON[("<b>SEMANTIC CONTRACT</b><br/>in RequirementIR v2<br/>want: integer · given: text<br/>allowed capsule · checks")]:::schr
    end
    subgraph ROW2 ["carry it out"]
        direction LR
        PB["<b>PLANNER-BINDER · PASS-THROUGH [M1]</b><br/>IN · the semantic contract<br/>DOES · no decisions: passes it on<br/>OUT · PlanIR · 1 step"]:::box_thin
        FRZ["<b>FREEZE · PASS-THROUGH [M1]</b><br/>IN · PlanIR<br/>DOES · pins it and passes it on<br/>OUT · run contract"]:::box_thin
        DSP["<b>SCHEDULE + DISPATCH · SIMPLIFIED [M1]</b><br/>IN · run contract<br/>DOES · one fixed node<br/>OUT · gated integer"]:::box_hot
        DEL["<b>DELIVERY [M1]</b><br/>IN · gated integer<br/>DOES · answers the user<br/>OUT · answer"]:::box_hot
    end
end
subgraph AROUND ["around the run"]
    direction LR
    RUN["<b>RUNNER [M1]</b><br/>IN · a node + its capsule<br/>DOES · assembles the Declaration, calls the sites<br/>OUT · outputs + invocation"]:::box_hot
    EVAL[["evaluator.evaluate<br/>PASS · FAIL · DEFER<br/>M1 caller: dispatch<br/>M2 adds planning"]]:::ver
    STORE["<b>STORE · SIMPLIFIED [M1]</b><br/>IN · an author's capsule<br/>DOES · admits once, keeps it by hash<br/>OUT · latest admitted"]:::box_sch
    SYM1["<b>SYMPHONY [M1 · HAVE]</b><br/>IN · admitted capsules<br/>DOES · indexes them; no planning<br/>OUT · ids by name"]:::box_sym
    OBS1["<b>OBSERVABILITY [M1]</b><br/>IN · every capsule call<br/>DOES · records from day one<br/>OUT · records for later loops"]:::box_obs
    subgraph NOT ["OUTSIDE M1 · the PRD sets this boundary"]
        direction TB
        X1["<s>library selection</s>"]:::gone
        X2["<s>planner intelligence</s>"]:::gone
        X3["<s>RSI</s>"]:::gone
        X4["<s>optimizer, merge</s>"]:::gone
        X5["<s>librarian</s>"]:::gone
        X6["<s>judges</s>"]:::gone
        X7["<s>meta-RSI</s>"]:::gone
    end
end
ANS>"HUMAN reads the answer<br/>back through the same frontend"]:::ext
FE -->|"request text + attachments"| INT
INT -->|"RawIntent"| ITN
ITN -->|"accepted IntentIR"| RQC
RQC -->|"RequirementIR v2"| CON
CON -->|"semantic contract"| PB
PB -->|"PlanIR · 1 step"| FRZ
FRZ -->|"run contract"| DSP
DSP -->|"gated integer"| DEL
STORE -.->|"admitted only"| SYM1
SYM1 ==>|"capsule id"| PB
STORE --o|"hashes to pin"| FRZ
DEL ==>|"answer"| ANS
ITN -.->|"reject / clarify"| ANS
DSP -->|"hands the node"| RUN
RUN -.->|"same runner"| ITN
RUN -.->|"same runner"| RQC
CON -.->|"checks"| DSP
STORE -.->|"code, checks"| RUN
DSP -.-> EVAL
ITN -.- OBS1
RQC -.- OBS1
DSP -.- OBS1
RUN -.- OBS1
