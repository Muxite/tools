flowchart TB
    author["Tool author"] --> declaration["CC declaration"]
    declaration --> factory["Software Factory"]
    factory --> release["Immutable CC release"]
    factory --> build["Build provenance"]
    release --> qualifier["Independent qualification"]
    qualifier --> catalog["CC catalog"]
    catalog -->|operation discovery| agent["Lab agent"]
    agent -->|request and inputs| admission["Admission and call binding"]
    release -->|release identity| admission
    admission --> boundCall["Bound call"]
