    runner --> outputs["Outputs"]
    runner --> receipt["Receipt"]
    receipt -.->|identifies| boundCall
    boundCall -.->|pins| release
    build -.->|identifies build subject| release
    outputs --> evaluation["Independent evaluation"]
    receipt --> evaluation