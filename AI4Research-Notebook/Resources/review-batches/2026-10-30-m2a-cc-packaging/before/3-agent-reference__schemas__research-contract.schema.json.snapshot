{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4r.local/schemas/m2a/research-contract",
  "title": "AI4R M2a research-contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0-m2a.1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "allowed_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "acceptance_obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "required_check_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "required_reproduction": {
            "enum": [
              "exact_replay",
              "controlled_replication",
              "evidence_inspection_only"
            ]
          }
        },
        "required": [
          "id",
          "criterion",
          "required_check_ids",
          "required_reproduction"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_units": {
          "type": "number",
          "minimum": 0
        },
        "cost_unit": {
          "type": "string",
          "minLength": 1
        },
        "max_child_depth": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_attempts",
        "max_wall_seconds",
        "max_cost_units",
        "cost_unit",
        "max_child_depth"
      ],
      "additionalProperties": false
    },
    "headless_missing_input": {
      "enum": [
        "block",
        "authorized_assumption_only"
      ]
    },
    "authorized_by": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "objective",
    "assumptions",
    "unresolved_questions",
    "constraints",
    "allowed_effects",
    "acceptance_obligations",
    "deliverables",
    "limits",
    "headless_missing_input",
    "authorized_by",
    "supersedes"
  ],
  "additionalProperties": false
}
