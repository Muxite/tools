          "uri": "fixture:workload-schema",
          "sha256": "fe89e8f2a9770f7663c47b44b6ac32249804222ed45249b0fc1a4e2bdc5748e1"
        }
      },
      {
        "name": "pack",
        "contract": {
          "uri": "fixture:pack-input",
          "sha256": "20df460932e0c4175e1d93bb043878fcdbed1618f05ea10277337806dc60a585"
        }
      }
    ]
  },
  "gives": {
    "status": "required",
    "items": [
      {
