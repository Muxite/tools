        }
      },
      {
        "id": "index-bounds",
        "definition": {
          "uri": "fixture:native-index-bounds",
          "sha256": "a58930157cfb8d6ded0b0061a07b163ce3851466264f63b7640c6925797da4bb"
        }
      }
    ]
  },
  "carriers": [
