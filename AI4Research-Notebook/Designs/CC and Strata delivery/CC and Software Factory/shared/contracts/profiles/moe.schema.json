{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4r:design:0.3:moe",
  "title": "Optional MoE vocabulary; omit directive for an outcome-only brief",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "goal": {
      "enum": [
        "reduce-storage",
        "compare-representation"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "shards": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "bytes",
              "sha256"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "native_index": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "producer": {
              "$ref": "urn:ai4r:design:0.3:common#/$defs/ref"
            }
          },
          "required": [
            "name",
            "producer"
          ]
        }
      },
      "required": [
        "repository",
        "revision",
        "shards",
        "native_index"
      ]
    },
    "preserve": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "directive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "method",
        "parameters",
        "target"
      ]
    }
  },
  "required": [
    "goal",
    "model",
    "preserve"
  ]
}
