{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4r.local/schemas/m2a/check-definition",
  "title": "AI4R M2a check-definition",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0-m2a.2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "checker_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stage": {
      "enum": [
        "admission",
        "pre_execution",
        "post_execution",
        "delivery"
      ]
    },
    "kind": {
      "enum": [
        "deterministic",
        "evidence",
        "semantic"
      ]
    },
    "owner": {
      "enum": [
        "package",
        "independent_policy"
      ]
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "applicability_rule": {
      "type": "string",
      "minLength": 1
    },
    "required_evidence_contracts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowed_evidence_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_units": {
          "type": "number",
          "minimum": 0
        },
        "cost_unit": {
          "type": "string",
          "minLength": 1
        },
        "max_child_depth": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_attempts",
        "max_wall_seconds",
        "max_cost_units",
        "cost_unit",
        "max_child_depth"
      ],
      "additionalProperties": false
    },
    "failure_behavior": {
      "enum": [
        "block",
        "reject",
        "inconclusive"
      ]
    },
    "qualification_fixture_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "uri",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "checker_digest",
    "stage",
    "kind",
    "owner",
    "entrypoint",
    "applicability_rule",
    "required_evidence_contracts",
    "allowed_evidence_scopes",
    "limits",
    "failure_behavior",
    "qualification_fixture_refs"
  ],
  "additionalProperties": false
}
